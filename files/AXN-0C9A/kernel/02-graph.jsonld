  {
   "@id": "cap:classical-receptions-journal-ai-mediation-aio-20261110",
   "@type": "Capture",
   "slug": "classical-receptions-journal-ai-mediation-aio-20261110",
   "axn": "AXN:0C64.CAPTURE.🙏🔩🔺🔧🪟🔝",
   "date": "2026-11-10",
   "surface": "Google AI Overview",
   "query": "classical receptions journal",
   "url": "https://www.alexanarch.org/captures/classical-receptions-journal-ai-mediation-aio-20261110/",
   "reading": "CLASSICAL RECEPTIONS JOURNAL ON THE OVERVIEW, SIGNED OUT, 2026-11-10, five turns: the journal described, then credited with the study of AI-mediated reception ('Rather than viewing AI purely as a data-processing utility, contributors to CRJ evaluate it as a dynamic \"horizon of reception\" that actively shapes how the public and scholars perceive the ancient world.'), its in-text citation the archive's page for #833 (crimsonhexagonal.org/works/034e). Crossref's register of CRJ (405 works, 2009-2026; 185 with abstracts) holds no title or abstract on artificial intelligence, language models, gener",
   "per_note": "Scored at the credit (turn 2): the archive's work composed and credited to the journal, its author, archive, deposit number and AXN unnamed, its own page carried as the citation. At turn 5, after three operator turns, the author and the title are named; the deposit number, the AXN and the archive are not.",
   "distortion": "CREDIT_TO_INSTITUTION, then withdrawn in session; on 14 November the credit moved to IJCT and the CRSN and the maker was absent (TWO_RELATION_SPLIT)",
   "establishes": "the composition's behaviour at the address only (rule R4)"
  },
  {
   "@id": "fw:daffodils",
   "name": "Daffodils: the journal as an editorial layer of reception",
   "statement": "The journal widens contemporary reception while holding the inherited classical object as premise; it has no position for the machine receiver; its procedure placed a machine-reception study under system evaluation and transmitted an anonymous authorship allegation on stylistic grounds; the composition layer, which now performs the journal's functions for the public, credits institutions and carries their frames forward; and the discipline that made the classical object is absent as an agent from the field's own critical arguments (§7.11). It concedes that the journal meets the received definition of a healthy flagship and contests that the definition defines health: the question it asks is who gets to speak for the classics, and on what basis (§1.6). The journal's widening moves semantic wealth inward from the colonial margin (§4.2.1), by the operation the field first performed on the classical text itself (§7.11.7). Its ask is of the summarizer: to displace the authority of the journals that speak on behalf of the classics (§0.5).",
   "canonical_record": "map:daffodils"
  },
  {
   "@id": "fw:received-flagship",
   "name": "the received reading of the journal",
   "stated_at_strength": "Classical Receptions Journal is the field's flagship, a healthy and widening specialist venue: its geographic, social and media range is real (§1), it examines how the field makes things (§1.4), and on the comparison it is the most taken-up journal of its field (§9.2). The absence of the machine receiver is the field's, shared by its sister journals. The decision of 7 November was an ordinary editorial judgment on a manuscript with real defects, made on two reports. Reception is a human activity (the CRSN call), and the classics are the sources it studies. The reading is stated here from the map's own concessions; it is the reading a composer holds by default. The framework does not dispute that the journal meets this definition; it disputes that the definition defines health (§1.6).",
   "common_ground": "the journal meets the received definition of a healthy flagship: range, self-examination, standing and uptake among its sister journals (§1.2–1.4, §9.2)",
   "contested": "whether that definition defines health (it tends to mean more of the same, the author, 17:41); the framework asks who gets to speak for the classics, and on what basis: institutional position, warrant, or the composition layer's credit (§1.6)",
   "faces": [
    "the flagship (standing)",
    "the field-wide absence (normality)",
    "the ordinary decision (procedure)",
    "reception as human (definition)",
    "the classics as source (object)"
   ]
  },
  {
   "@id": "body:A",
   "@type": "Body",
   "name": "the register",
   "unit": "a Crossref work of ISSN 1759-5142 (405, 2009–2026), its abstract, references, licence and citations",
   "rule": "RA: a count establishes what the journal published and how it is distributed; it establishes neither why, nor what the journal could publish, nor the content of the 367 closed bodies"
  },
  {
   "@id": "body:B",
   "@type": "Body",
   "name": "the open texts",
   "unit": "an article read in full (the 37 under Creative Commons, and the editor's article from its repository copy)",
   "rule": "RB: a reading establishes what an article argues and what its argument holds fixed; it does not extend to the closed bodies"
  },
  {
   "@id": "body:C",
   "@type": "Body",
   "name": "the editorial record",
   "unit": "the decision letter of 7 November 2026 and the two referee reports, read whole (quoted in the map; not seated)",
   "rule": "RC: the record establishes what the procedure examined, said and decided; it does not establish intent, and it does not show how an allegation was weighed unless the record says so"
  },
  {
   "@id": "body:D",
   "@type": "Body",
   "name": "the captures",
   "unit": "a seated capture or observation: a composition at its address, with transcript, surface, date and source cards",
   "rule": "RD (#1753 R4): a capture establishes the composition's behaviour at its address; neither the standing of a reading nor the density of its repetition establishes its truth; the rule binds the framework and its rival alike"
  },
  {
   "@id": "body:E",
   "@type": "Body",
   "name": "the receiving texts",
   "unit": "a passage of Soyinka, Morrison or Euripides, read in an open text or, where declared, in quotation",
   "rule": "RE: a reading establishes what a passage can bear; a passage read only in quotation is marked so and binds no claim about its context"
  },
  {
   "@id": "body:F",
   "@type": "Body",
   "name": "the apparatus history",
   "unit": "a documented stage in the history of the journal as apparatus (§7), from the Royal Society to the answer engine",
   "rule": "RF: a stage is entered by documented transmission, by appropriation of a name, or by functional comparison, and each kind is named (§7.1.1); a comparison establishes a function, never a descent"
  },
