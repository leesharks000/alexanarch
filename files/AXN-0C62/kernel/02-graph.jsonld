  {
   "@id": "argument:one-maker",
   "thesis": "one composing person better explains the Socratic–Peripatetic configuration — its divisions, its production mechanics and its editorial multiplication — than separate composing persons do",
   "standing": "argued from the corpus, comparatively; held by the author as biographical identity (2026-11-08 20:00; 2026-11-09 12:05). A biographical hypothesis argued from the corpus and a directly attested biographical identification are different achievements: the first is argued here; the second is unattested for any count (RB).",
   "steps": [
    {
     "step": 1,
     "move": [
      "arg:a1658-nothing-requires-two"
     ],
     "role": "no text requires a second maker"
    },
    {
     "step": 2,
     "move": [
      "arg:a1576-result",
      "arg:a1576-symmetric-null"
     ],
     "role": "two is not established by the passages read as though it were; the discipline's instrument leaves the received relation-type as unestablished as the hypothesis"
    },
    {
     "step": 3,
     "move": [
      "arg:a1576-voices-objects",
      "arg:a1576-capacity-conceded"
     ],
     "role": "one maker can be many voices (Plato) and many objects (Aristotle); the capacity is conceded in the tradition's own testimony"
    },
    {
     "step": 4,
     "move": [
      "arg:a1733-set-explains"
     ],
     "role": "the comparison: the received reading explains each item by a person; the single-maker reading explains the set by one investigation, and the marks"
    },
    {
     "step": 5,
     "move": [
      "arg:a1733-set-by-filing",
      "arg:a1733-count-kept",
      "arg:a1733-wills-dependent"
     ],
     "role": "the count was set by filing before argument, and the wills offered as independent corroboration reach the reader in one text"
    },
    {
     "step": 6,
     "move": [
      "arg:a1658-ledger-finding"
     ],
     "role": "the one item outside the manuscripts attests one legal person, Aristotle"
    },
    {
     "step": 7,
     "move": [
      "arg:a123-pattern"
     ],
     "role": "configurations whose maker count can be inspected produce volume comparable to the combined corpus from one hand",
     "note": "#123's lifespan premise is bounded (lifespan_state); this step stands on the comparative cases"
    },
    {
     "step": 8,
     "statement": "claim:hl-stmt-biographical",
     "role": "the author's grounds: the reading conforms to 'the psychological and production mechanics of authorial configurations whose maker count we can inspect'; the many-author reading 'requires the circularity and pointing to hypothetical second witnesses to make sense'"
    }
   ],
   "rival": {
    "claims": [
     "arg:a1733-received-rival",
     "arg:a1658-two-persons-rival"
    ],
    "standing": "the four persons rest on the Lives and the succession of the schools (#1733); RB withholds biographical standing from both counts alike"
   },
   "qualified_by": [
    "arg:a1733-not-decide",
    "arg:a1576-not-adjudicated"
   ],
   "breaks_if": [
    "arg:a1733-falsify-wills",
    "an epigraphic or papyrological item attesting a second composing person (Q1)"
   ],
   "substitution_test": "replacing 'one person' with 'a collective', 'a school' or 'a mystical self-dividing entity' changes the thesis; the author: 'one self-dividing maker does mean one biological person' (2026-11-08 20:00)",
   "@type": "ComparativeArgument"
  },
