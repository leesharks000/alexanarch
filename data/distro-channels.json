 "standing_rules": [
  "alexanarch canonical in all cases; distributed copies are surfaces not homes",
  "every DataCite re-deposit carries relatedIdentifier crosswalk to its dead 10.5281 DOI",
  "every record description carries AXN with glyph + alexanarch canonical URL",
  "moderated channels receive human-paced traffic; never reproduce the serial-deposit signature",
  "no distribution act without same-commit index update (EA-DISTRO-01 \u00a76)",
  "private correspondence is never distributed"
 ]
