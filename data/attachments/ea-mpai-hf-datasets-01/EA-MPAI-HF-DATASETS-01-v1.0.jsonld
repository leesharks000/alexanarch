   "sp:targetClassAtSnapshot": "emitted-rhizome",
   "sp:note": "The holographic kernel is a formal apparatus here and deliverable eight there. THAT BODY DEPLOYS IT; this one defines what it must satisfy."
  },
  {
   "@id": "urn:alexanarch:draft:EA-MPAI-HF-DATASETS-01:stolon:model-collapse-anti-collapse:9",
