  {
   "@id": "fw:revelation-first",
   "@type": "Framework",
   "canonical_record": "rec:202"
  },
  {
   "@id": "hk:tenthmuse/seat/kenos",
   "@type": "Seat",
   "kernel": "EA-HK-TENTHMUSE-01",
   "local_id": "seat:kenos",
   "sappho_in_this_seat": {
    "status": "proposed",
    "by": "the author, 2026-11-08 21:46",
    "proposal": "hk:tenthmuse/claim/tm-third-reversal",
    "line_of_research": "Q1-third-reversal (EA-HK-TENTHMUSE-01)"
   },
   "note": "proxy: the same IRI as the node in EA-HK-TENTHMUSE-01's graph",
   "name": "that man — the future reader who takes her up, in whose body she lives again"
  },
  {
   "@id": "hk:historical-logos",
   "@type": "PlannedFramework",
   "founding_record": "rec:625",
   "note": "planned; its kernel will hold this IRI"
  },
  {
   "@id": "hk:orthonym/fw/socrates-as-orthonym",
   "@type": "Framework",
   "canonical_record": "rec:123",
   "kernel": "EA-HK-ORTHONYM-01 (#1754)",
   "local_id": "fw:socrates-as-orthonym",
   "note": "#1754's context declares no prefix for fw:, so its node has no namespaced IRI; this IRI is assigned here for the program and names that node"
  },
  {
   "@id": "fw:current-consensus-chronology",
   "@type": "RivalFramework",
   "name": "the current consensus chronology",
   "claim": "Pauline priority by the Gallio synchronism through Acts; the Domitianic date on Irenaeus, Adv. Haer. 5.30.3; the Apocalypse last, derivative and secondary (#1741); the source apparatus that grants the reconstructed Q standing (#1746, #1747).",
   "stated_at_strength": "Stated with the arguments it already has: the Gallio synchronism, the Irenaean date, the late-twentieth-century consensus, the source apparatus. A reading that reduces it to 'scholars assume Paul came first' is a reduction of it.",
   "status": {
    "D": {
     "text": "the synchronism dates Gallio and reaches 1 Thessalonians only through Acts (site rung II); the Irenaean anchor is a reception memory and not an inscriptional date (site rung I). Not established by an external or material anchor.",
     "warrants": [
      "rv-site-gallio",
      "rv-site-irenaeus",
      "rv-site-reception-memory"
     ]
    },
    "C": {
     "text": "no first-century sevenfold Pauline collection is evidenced, by the concession of a Pauline-priority account (site rung III).",
     "warrants": [
      "rv-site-collection"
     ]
    },
    "G": {
     "text": "the genre objection explains the letters' missing circumstances and leaves their Christian forms' missing ancestors unexplained (#1735 §VI.2); Revelation against Q's requirements is graded, three met (#1747). The derivative standing is a reception (#1741), and no direction is demonstrated by it.",
     "warrants": [
      "rv-1735-genre",
      "rf-1747-grades"
     ]
    },
    "R": {
     "text": "the reconstructed sources hold the four powers of evidentiary status — presupposition, assignment, text and candidacy — and the extant Apocalypse holds none (#1746); the reception is documented and is not asked to prove either framework (#1741).",
     "warrants": [
      "rv-1746-four-powers",
      "rv-1746-powers",
      "rv-1741-separate"
     ]
    },
    "H": {
     "text": "ordinary multiple authorship stands as the economical account that defeats rung V wherever it explains the phenomena better (site rung V); it is owed as a comparator, stated wherever it is used.",
     "warrants": [
      "rv-site-redundancy"
     ]
    }
   },
   "rule": "RD–RH apply to both frameworks; the burden is symmetrical (#202; site /unfolding/)."
  },
  {
   "@id": "rung:I",
   "@type": "Rung",
   "name": "the reversed consensus (dating)",
   "claim": "The Domitianic date is not settled",
   "fit": "REVERSIBLE",
   "body": "D",
   "source": "site:ladder-dating",
   "quote": "the same broad dossier has supported opposite critical majorities",
   "defeat": "An external or material anchor fixing the received form of Revelation after 70 CE.",
   "defeat_scope": "Defeats rung I's own claim, that the late date is not settled. It does not by itself defeat first composition: 'Early is not yet first' (rung I). A post-70 anchor for Revelation constrains the chronology; it defeats absolute priority only in an ordering, where an independent anchor places another New Testament composition earlier (rung II; #1735 §VIII).",
   "depends_on": [],
   "located_in": "text"
  },
  {
   "@id": "rung:II",
   "@type": "Rung",
   "name": "the Gallio gap (Pauline priority)",
   "fit": "SAME-CLASS",
   "body": "D",
   "source": "site:ladder-priority",
   "quote": "The load-bearing link is of the same inferential class as the evidence it is asked to overrule.",
   "defeat": "An independent, securely dated anchor — material or external, but not the corpus’s self-narrated chronology — placing the composition of any Pauline letter before the earliest plausible date of Revelation’s received form.",
   "depends_on": [],
   "located_in": "text"
  },
  {
   "@id": "rung:III",
   "@type": "Rung",
   "name": "the first corpus",
   "fit": "INDEPENDENT",
   "body": "C",
   "source": "site:ladder-corpus",
   "quote": "This rung stands whether or not the rungs above it do.",
   "defeat": "Evidence of a sevenfold Pauline church collection demonstrably circulating before Revelation, or a persuasive demonstration that Revelation’s number, order and single-book architecture depend on such a collection.",
   "depends_on": [],
   "located_in": "text"
  },
  {
   "@id": "rung:IV",
   "@type": "Rung",
   "name": "the midrashim transform",
   "fit": "EXECUTABLE",
   "body": "G",
   "source": "site:unfolding",
   "quote": "The comparison is between inferences. The burden is symmetrical.",
   "defeat": "Identify New Testament passages that cannot be derived from Revelation through any plausible transform: these are the counterevidence.",
   "defeat_scope": "'Any plausible transform' is bounded by the kernel's transform_procedure: the declared steps and operations, fixed before the test, with residue shown.",
   "depends_on": [],
   "located_in": "text"
  },
  {
   "@id": "rung:V",
   "@type": "Rung",
   "name": "the Josephus thesis",
   "fit": "CONTINGENT",
   "body": "H",
   "source": "site:ladder-heteronyms",
   "quote": "It is defeated without disturbing rungs I–IV, and rungs I–IV do not depend on it in any direction.",
   "defeat": "Contingent by construction. Defeated without disturbing rungs I–IV. It is also defeated by demonstration that the phenomena it explains are more economically explained by ordinary multiple authorship.",
   "depends_on": [],
   "located_in": "text"
  },
  {
   "@id": "rung:VI",
   "@type": "Rung",
   "name": "the permanent incarnation (the Logos)",
   "fit": "DEPENDENT",
   "depends_on": [
    "rung:V"
   ],
   "body": "H",
   "source": "site:ladder-logos",
   "quote": "The reading does not deny that a historical person could have existed. It denies that the textual evidence requires one.",
   "defeat": "Depends on V. Defeated without disturbing rungs I–IV.",
   "joins": "hk:historical-logos",
   "located_in": "text"
  },
