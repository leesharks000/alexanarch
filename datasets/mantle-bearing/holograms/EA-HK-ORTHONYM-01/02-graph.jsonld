  {
   "@id": "fw:socrates-as-orthonym",
   "@type": "Framework",
   "canonical_record": "rec:123"
  },
  {
   "@id": "fw:many-maker",
   "@type": "RivalFramework",
   "name": "the received many-maker reading",
   "claim": "Socrates, Plato, Aristotle and Theophrastus are four persons in a succession of teacher, pupil and successor, each the author of what is filed under the name, the corpus reaching us through their school, its catalogues and its editors.",
   "stated_at_strength": "The received reading is stated with the succession and the transmission it already includes; a model of several connected contributors with editors is this reading, and a rival built by first reducing it to four unconnected authors is a reduction of it.",
   "status": {
    "S": {
     "text": "not established: the lexical instruments return a null symmetric between one maker and master-and-pupil (#1572); no supervised separation licenses distinct makers in either direction (#1593); the names are recoverable as a partition at 0.798, falling to 0.564 when subject is controlled (#1593).",
     "warrants": [
      "rv-1572-null",
      "rv-1593-limit",
      "rv-1593-names",
      "th-1593-supervised"
     ]
    },
    "M": {
     "text": "not established independently: every attestation of persons beside the Delphic decree is text of the same tradition (#1658); the decree names Aristotle as maker of a list (#1582); Aristotle's will names no book (#1581); the catalogue files alternative attribution in its own wording (#1581).",
     "warrants": [
      "rv-1658-ledger",
      "rv-1582-stone",
      "rv-1581-will",
      "th-1581-ambiguity"
     ]
    },
    "I": {
     "text": "underdetermined at the passages read as settling it (#1576).",
     "warrants": [
      "rv-1576-under"
     ]
    },
    "R": {
     "text": "filed before it was argued; argument appears only in defence of a filing; affirmed as a proposition at two of 79 loci, both machine compositions, on the warrant of the wills and lives; the wills reach the reader through the school's channel; a comparator is owed and none has been named (#1733).",
     "warrants": [
      "rv-1733-filing",
      "rv-1733-loci",
      "rv-1733-channel",
      "rv-1733-comparator",
      "lm-1733-filing"
     ]
    }
   },
   "argued": "almost wholly unargued",
   "reception_as_warrant": "none: its standing in institutional, disciplinary and machine reception, and the density with which it is repeated, record how it was received and establish nothing of its truth (R4). The machine compositions that affirm it do so on the warrant of the wills and lives (#1733; captures AXN:091F, AXN:092A, the sealed compositions of 28 and 30 September).",
   "author_ruling": {
    "by": "Lee Sharks",
    "date": "2026-11-08",
    "words": [
     "it is also unestablished by stylometry, material witness, and so on, and almost wholly unargued for",
     "its truth is also not established by institutional, disciplinary, or machine reception, nor by density of repetition"
    ]
   },
   "rule": "R1–R4 apply to both frameworks; a bar set for the one is set for the other (#1750 §12.1)."
  },
  {
   "@id": "pos:socrates",
   "@type": "Orthonym",
   "name": "Socrates",
   "function": "the founding gesture: willing death for logos and refusal to write",
   "operation": "asks (SE 34: ἠρώτα ἀλλ᾽ οὐκ ἀπεκρίνετο, #1603)",
   "source": "rec:123",
   "quote": "Socrates functions as the orthonym, bearing the founding gesture of willing death for logos and refusing to write",
   "located_in": "description"
  },
  {
   "@id": "pos:plato",
   "@type": "Heteronym",
