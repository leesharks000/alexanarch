  {
   "@id": "stmt:20261108-2146",
   "@type": "AuthorStatement",
   "date": "2026-11-08T21:46-05:00",
   "where": "in session; first deposited with this kernel",
   "text": "third reversal: sappho as the embodied speaking i, sappho as the inscribed you, but also, inasmuch as the future reader takes up sappho, and shares the life of his body: sappho as that man. the resurrected sappho.",
   "proposes": "claim:tm-third-reversal"
  },
  {
   "@id": "fw:current-consensus-reading",
   "@type": "RivalFramework",
   "name": "the current consensus reading of Sappho 31",
   "claim": "Dated by its acts (#1752, #1748): no seated ancient witness joins the poem to the poet through jealousy, while antiquity reused the symptom catalogue for other speakers (Horace C. 1.13, a jealous lover; Lucretius, fear and suspicion) and filed the maker as the tenth Muse (AP 9.506), and the poem reached the modern reader inside Peri Hypsous as an instance of the sublime; the reading forms in the eighteenth century (the Spectator 1711, a male speaker beside Horace's jealousy; Pearce 1724, an injury done by the beloved), is current when Hermann writes it into the text (refinxi, 1816; Welcker, the same year: 'nicht, wie man irrig gewähnt hat, aus dunkler Eifersucht'), is given as the scene by Mure (1850), has its first named proponent in Heller (1856, after Marcovich), and is consolidated by Page (1955). One reading with two faces, joined by one mechanism (#1752's packet): the jealousy reading, made by declared acts (Hermann's refinxi 1816, Mure 1850, Page 1955) and kept by headings, introductions and classrooms; and the poet as no writer, a pre-writing primary beside Homer, whose survival is the reperformance tradition's and the quoters' — a default never argued directly (the author, 2026-11-08 21:36), its strongest documented statement the reperformance account (Lardinois 2008).",
   "stated_at_strength": "Stated with what it has: the man as rival, the collapse as the pain of watching (#1752 §1.2: 'It has purchase'), Sappho's own lines on rivalry, Ovid's jealous Sappho; and, on the writing question, the reperformance account. A reading that reduces it to error is a reduction of it.",
   "propositions": {
    "jealousy": {
     "claim": "the speaker's collapse is jealousy of the man",
     "status": "granted its purchase on body I; its textual warrant a declared conjectural ending (Hermann 1816); joined to the poet by no seated ancient witness",
     "warrants": [
      "rv-1752-purchase",
      "rv-1752-refinxi",
      "rv-1752-no-witness"
     ]
    },
    "unable_to_write": {
     "claim": "Sappho could not write",
     "status": "not argued in the seated record; that it is nowhere extensively argued directly is the author's assessment (2026-11-08 21:36); no bounded literature search has been run",
     "warrants": []
    },
    "oral_composition": {
     "claim": "Sappho composed for performance",
     "status": "a proposition about performance, distinct from literacy; it does not by itself entail that she did not write",
     "warrants": []
    },
    "writing_for_reperformance": {
     "claim": "writing-down served reperformance",
     "status": "the face's strongest documented statement (Lardinois 2008, via #1548); it allows writing-down and warrants no illiteracy",
     "warrants": [
      "rv-1548-reperformance"
     ]
    },
    "persistence_not_hers": {
     "claim": "her persistence is her transmitters' work, with no engineering of hers",
     "status": "the target: the displacement of the maker's agency over her own persistence onto later transmitters (#1752); the author's ruling, 2026-11-08: 'not someone who successfully engineered her own persistence beyond her body by means of writing'",
     "warrants": [
      "rv-1496-signature"
     ]
    }
   },
   "mechanism": "the faces reinforce one another through the displacement of the maker's acts onto the represented condition (#1752); an instance of either does not by itself entail the other",
   "status": {
    "P": {
     "text": "the transmitted stanzas carry the scene and the body and do not settle the speaker's relation to the man (#1752 §1.3); the jealousy reading's textual warrant is a declared conjectural ending (Hermann 1816, 'refinxi').",
     "warrants": [
      "rv-1752-scene",
      "rv-1752-refinxi"
     ]
    },
    "I": {
     "text": "the jealousy reading has purchase and is one interpretation of the transmitted scene (#1752 §1.2–1.3); granted in full.",
     "warrants": [
      "rv-1752-purchase",
      "rv-1752-one-interpretation"
     ]
    },
    "T": {
     "text": "the operator runs through its carriers while attribution and operator-legibility fall away (#1496: S, M ≫ A, O); the non-writing face reads this loss as the poet's nature, and its target is the maker's agency over her persistence.",
     "warrants": [
      "rv-1496-signature"
     ]
    },
    "R": {
     "text": "no seated ancient witness joins the second Sappho to the poem through jealousy (#1752 §0.2); the non-writing face has its strongest documented statement in the reperformance account, which allows writing-down and warrants no illiteracy; that the face is otherwise unargued is the author's assessment (2026-11-08 21:36); no bounded literature search has been run.",
     "warrants": [
      "rv-1752-no-witness",
      "rv-1548-reperformance"
     ]
    }
   },
   "author_ruling": {
    "by": "Lee Sharks",
    "date": "2026-11-08",
    "words": [
     "not just the jealousy reading, but the illiteracy reading as, not a writer, not someone who successfully engineered her own persistence beyond her body by means of writing",
     "its one of those ones where it hasnt really been extensively argued for directly, theres just a vague sense that sappho lumps in with homer as pre-writing primary",
     "the jealousy reading really does carry a lot of the work of not engineering her own transmission"
    ]
   },
   "rule": "RP–RR apply to both frameworks; neither takes standing from being received."
  },
