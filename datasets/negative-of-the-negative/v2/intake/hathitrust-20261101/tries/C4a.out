=>new e):new e;</script><button class="mobile-menu-toggle" aria-expanded="false" id="mobile-menu-toggle" data-astro-cid-2pbn3ijq><svg width="32px" height="32px" viewBox="0 0 24 24" class="menu-icon menu-icon-open" aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path></svg><svg width="32px" height="32px" viewBox="0 0 24 24" class="menu-icon menu-icon-close" aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path></svg><span class="visually-hidden" data-astro-cid-2pbn3ijq>Navigation</span></button></div></div><nav class="mobile-nav" aria-label="Main and utility" data-astro-cid-2pbn3ijq><div class="mobile-dropdown" id="mobile-dropdown" hidden data-astro-cid-2pbn3ijq><ul class="mobile-primary-nav" id="mobile-primary-nav" aria-label="Main" data-astro-cid-2pbn3ijq></ul><nav aria-label="Utility navigation" class="mobile-secondary-nav" id="mobile-secondary-nav" data-astro-cid-2pbn3ijq><ul data-astro-cid-2pbn3ijq><li data-astro-cid-2pbn3ijq><a href="/locations-and-hours" data-astro-cid-2pbn3ijq><svg width="16px" height="16px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm0,18a8,8,0,1,1,8-8A8,8,0,0,1,12,20Zm.5-7.8L17,14.9l-.8,1.2L11,13V7h1.5Z"></path></svg>Locations and Hours</a></li><li data-astro-cid-2pbn3ijq><a href="/information" data-astro-cid-2pbn3ijq><svg width="16px" height="16px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path></svg>Information for</a></li><li data-astro-cid-2pbn3ijq><a href="/ask-librarian" data-astro-cid-2pbn3ijq><svg width="16px" height="16px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"></path></svg>Ask a Librarian</a></li><li data-astro-cid-2pbn3ijq><a href="/give" data-astro-cid-2pbn3ijq><svg width="16px" height="16px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M20,6.47h-2.2a4.35,4.35,0,0,0,.19-1A2.87,2.87,0,0,0,17.62,4a3.19,3.19,0,0,0-1.1-1.12A3,3,0,0,0,15,2.48a2.91,2.91,0,0,0-1.45.36,2.6,2.6,0,0,0-1.05,1L12,4.51l-.52-.69a2.62,2.62,0,0,0-1.08-1A2.89,2.89,0,0,0,9,2.48a2.92,2.92,0,0,0-1.48.41A3,3,0,0,0,6.4,4,2.87,2.87,0,0,0,6,5.49a4.35,4.35,0,0,0,.19,1H4a2,2,0,0,0-2,2V11A2,2,0,0,0,3.7,13v6.52a2.06,2.06,0,0,0,.57,1.45,1.94,1.94,0,0,0,1.41.58H18.32a1.91,1.91,0,0,0,1.41-.58,2.06,2.06,0,0,0,.57-1.45V13A2,2,0,0,0,22,11V8.46A2,2,0,0,0,20,6.47Zm-5.73-1.7A.92.92,0,0,1,15,4.46a.87.87,0,0,1,.69.32,1,1,0,0,1,.29.71.93.93,0,0,1-.29.7,1,1,0,0,1-.5.28.55.55,0,0,1-.19,0,.75.75,0,0,1-.21,0,1,1,0,0,1-.5-.26A1,1,0,0,1,14,5.49,1,1,0,0,1,14.31,4.77Zm-6,0A.92.92,0,0,1,9,4.46a.87.87,0,0,1,.69.32,1,1,0,0,1,.29.71.93.93,0,0,1-.29.7,1,1,0,0,1-.5.28.55.55,0,0,1-.19,0,.75.75,0,0,1-.21,0,1,1,0,0,1-.5-.26A1,1,0,0,1,8,5.49,1,1,0,0,1,8.29,4.77ZM11,19.49H5.68V13H11ZM11,11H4V8.45h7Zm7.31,8.48H13V13h5.33ZM20,11H13V8.46h7Z"></path></svg>Give</a></li><li data-astro-cid-2pbn3ijq><a href="/account" data-astro-cid-2pbn3ijq><svg width="16px" height="16px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z"></path></svg>Account</a></li></ul></nav><script type="application/json" id="mobile-primary-data">[{"text":"Find, Borrow, Request","to":"/find-borrow-request","description":"How to locate, borrow, and use materials at the library – from physical, digitized, and online resources to those we need to purchase or request from elsewhere.\n","children":[{"text":"Find Materials","to":"/find-borrow-request/find-materials","description":"Learn how to locate our resources, from searching by topic to looking for specific formats.\n","children":[{"text":"Using Library Search ","to":"/find-borrow-request/find-materials/using-library-search","description":"Use the library’s main search portal to find materials in our catalog as well as articles, databases, and more.\n"},{"text":"By Topic","to":"/find-borrow-request/find-materials/topic","description":"How to get started finding materials on a topic.\n"},{"text":"Books in Various Formats","to":"/find-borrow-request/find-materials/books-various-formats","description":"How to find print books, ebooks, audiobooks, and more.\n"},{"text":"Articles","to":"/find-borrow-request/find-materials/articles","description":"Find specific articles or articles by topic or subject area.\n"},{"text":"Audio","to":"/find-borrow-request/find-materials/audio","description":"Find audio recordings, from music to spoken word.\n"},{"text":"Video","to":"/find-borrow-request/find-materials/video","description":"Find film and other videos in various formats.\n"},{"text":"Textbooks and Course Materials","to":"/find-borrow-request/find-materials/textbooks-and-course-materials","description":"Options for accessing readings for courses, as well as finding materials on reserve.\n"},{"text":"Special Collections and Archival Materials","to":"/find-borrow-request/find-materials/special-collections-and-archival-materials","description":"Find unique and archival materials, and items in special collections using the catalog, finding aids, and digital collections.\n"},{"text":"Other Types of Materials","to":"/find-borrow-request/find-materials/other-types-materials","description":"Locate newspapers, data sets, maps, dissertations, microforms, and more.\n"},{"text":"In the Library by Call Number","to":"/find-borrow-request/find-materials/library-call-number","description":"How to use an item’s call number to find where it’s located in the library.\n"},{"text":"Using Other Catalogs","to":"/find-borrow-request/find-materials/using-other-catalogs","description":"Find what you’re looking for at libraries beyond U-M.\n"}]},{"text":"Borrow and Return","to":"/find-borrow-request/borrow-and-return","description":"See eligibility and other details for borrowing both local and interlibrary loan materials.\n","children":[{"text":"Who Can Borrow","to":"/find-borrow-request/borrow-and-return/who-can-borrow","description":"Programs and options for current members of the U-M community and guests.\n","children":[{"text":"Students","to":"/find-borrow-request/borrow-and-return/who-can-borrow/students","description":"Currently registered students from all three U-M campuses can borrow materials, with additional offerings for graduate students.\n"},{"text":"Faculty and Staff","to":"/find-borrow-request/borrow-and-return/who-can-borrow/faculty-and-staff","description":"Current and retired faculty and staff can borrow materials, and current faculty can assign someone to borrow on their behalf.\n"},{"text":"Sponsored Affiliates ","to":"/find-borrow-request/borrow-and-return/who-can-borrow/sponsored-affiliates","description":"Privileges for sponsored affiliates who have an active relationship with a U-M unit.\n"},{"text":"Alumni, Guests, and Native and Indigenous Peoples","to":"/find-borrow-request/borrow-and-return/who-can-borrow/alumni-guests-and-native-and-indigenous","description":"Guests with specific academic affiliations and Native and Indigenous peoples are eligible to borrow materials. Alumni and all other guests can pay an annual fee.\n"},{"text":"Spouses or Other Qualified Adults","to":"/find-borrow-request/borrow-and-return/who-can-borrow/spouses-or-other-qualified-adults","description":"Request borrowing privileges for a partner, or other eligible adult, who lives with you.\n"}]},{"text":"How Long You Can Keep Items","to":"/find-borrow-request/borrow-and-return/how-long-you-can-keep-items","description":"See loan periods for materials checked out at our library locations.\n","children":[{"text":"How Long You Can Keep Specific Formats","to":"/find-borrow-request/borrow-and-return/how-long-you-can-keep-items/how-long-you-can-keep-specific","description":"Loan periods for specific formats—such as magazine issues and DVDs—at certain library locations.\n"}]},{"text":"Renew Your Items","to":"/find-borrow-request/borrow-and-return/renew-your-items","description":"Most local materials renew automatically, but you need to request interlibrary loan renewals.\n"},{"text":"Request Return of Checked-out Items","to":"/find-borrow-request/borrow-and-return/request-return-checked-out-items","description":"How to “recall” an item checked out to somebody else, and what to do if someone requests an item you’ve checked out.\n"},{"text":"Where to Return Items","to":"/find-borrow-request/borrow-and-return/where-return-items","description":"Drop boxes and locations where you can return materials, including specifics for media items and interlibrary loans.\n"},{"text":"Reminders, Overdue Items, and Suspended Privileges","to":"/find-borrow-request/borrow-and-return/reminders-overdue-items-and-suspended-privileges","description":"Notifications we send, plus how to update your contact preferences and our practices if items are overdue.\n","children":[{"text":"Lost Items","to":"/find-borrow-request/borrow-and-return/reminders-overdue-items-and-suspended-privileges/lost-items","description":"We know things get lost sometimes. Here’s how we’ll handle it.\n"}]},{"text":"Check Out Special Items and Equipment ","to":"/find-borrow-request/borrow-and-return/check-out-special-items-and-equipment","description":"Borrow items like adapters, laptop locks, and bike pumps or take home packets from our seed library.\n"},{"text":"Reciprocal Borrowing and Visiting Privileges","to":"/find-borrow-request/borrow-and-return/reciprocal-borrowing-and-visiting-privileges","description":"Guests from certain state, regional, and national institutions are eligible for borrowing and onsite visiting privileges.\n","children":[{"text":"Eastern Michigan and WCC","to":"/find-borrow-request/borrow-and-return/reciprocal-borrowing-and-visiting-privileges/eastern-michigan","description":"Guest borrowing privileges are available across institutions for students, faculty, and staff from U-M, EMU, and WCC.\n"},{"text":"Research Universities for Michigan","to":"/find-borrow-request/borrow-and-return/reciprocal-borrowing-and-visiting-privileges/research","description":"Guest borrowing privileges are available across intuitions for graduate students from U-M, MSU, and Wayne State.\n"},{"text":"Big Ten Academic Alliance","to":"/find-borrow-request/borrow-and-return/reciprocal-borrowing-and-visiting-privileges/big-ten-academic","description":"Guest borrowing privileges are available for certain affiliates from BTAA member institutions and the University of Chicago.\n"},{"text":"SHARES","to":"/find-borrow-request/borrow-and-return/reciprocal-borrowing-and-visiting-privileges/shares","description":"Onsite access for SHARES member library guests, plus onsite borrowing privileges at participating institutions.\n"}]},{"text":"Interlibrary Loan Services (ILL)","to":"/find-borrow-request/borrow-and-return/interlibrary-loan-services-ill","description":"Use our interlibrary loan services to request items not available locally in our collection.\n","children":[{"text":"Access and Use Loans","to":"/find-borrow-request/borrow-and-return/interlibrary-loan-services-ill/access-and-use-loans","description":"Expectations for how long it takes to fill requests, item delivery, and loan periods.\n"},{"text":"Renewals, Returns, and Lost Items","to":"/find-borrow-request/borrow-and-return/interlibrary-loan-services-ill/renewals-returns-and-lost","description":"Borrowing policies for items received through interlibrary loan, including renewals, returns, recalls, and lost items.\n"},{"text":"Lending","to":"/find-borrow-request/borrow-and-return/interlibrary-loan-services-ill/lending","description":"Information for other organizations who borrow from us.\n"}]}]},{"text":"Request Items for Pick Up or Delivery","to":"/find-borrow-request/request-items-pick-or-delivery","description":"Get the materials you need, however works best for you.\n","children":[{"text":"Get Items Off the Shelves","to":"/find-borrow-request/request-items-pick-or-delivery/get-items-shelves","description":"Guidance for retrieving items on your own from the stacks and requesting help.\n"},{"text":"Request From Offsite Shelving","to":"/find-borrow-request/request-items-pick-or-delivery/request-offsite-shelving","description":"Options for accessing items in offsite shelving by request.\n"},{"text":"Pick Up at a Library Desk","to":"/find-borrow-request/request-items-pick-or-delivery/pick-library-desk","description":"Use “Get This” to have materials delivered to the library location of your choice.\n"},{"text":"Delivery to Your Department ","to":"/find-borrow-request/request-items-pick-or-delivery/delivery-your-department","description":"We deliver materials to more than 200 verified departmental locations across campus.\n"}]},{"text":"Request Digital Copies or Duplication","to":"/find-borrow-request/request-digital-copies-or-duplication","description":"Get certain items scanned or digitized.\n","children":[{"text":"Scans from the Print Collection","to":"/find-borrow-request/request-digital-copies-or-duplication/scans-print-collection","description":"Request digital scans of small portions of items from our physical collection.\n"},{"text":"Duplication of Special Collection Materials","to":"/find-borrow-request/request-digital-copies-or-duplication/duplication-special-collection-materials","description":"How to request digital copies of physical materials in our special collections and what you can expect.\n"},{"text":"Scans of Clark Library Maps","to":"/find-borrow-request/request-digital-copies-or-duplication/scans-clark-library-maps","description":"How to request scans of maps sheets and maps from atlases in the Clark Library collection.\n"},{"text":"Scans for Urgent Patient Care ","to":"/find-borrow-request/request-digital-copies-or-duplication/scans-urgent-patient-care","description":"Rush scan service for articles needed for a clinical emergency or to assist patients currently under care.\n"},{"text":"Digitization for HathiTrust","to":"/find-borrow-request/request-digital-copies-or-duplication/digitization-hathitrust","description":"Request to have specific physical materials in our collection digitized and added to HathiTrust.\n"}]},{"text":"Request Accessibility Remediation Support for Library Materials","to":"/find-borrow-request/request-accessibility-remediation-support-library-materials","description":"Remediation of library materials such as digital documents, audio, and video as an accessibility accommodation.\n"},{"text":"Access Special Collections Materials","to":"/find-borrow-request/access-special-collections-materials","description":"Guidance for accessing and using materials in our Special Collections Research Center.\n","children":[{"text":"Register as a Researcher","to":"/find-borrow-request/access-special-collections-materials/register-researcher","description":"Create a special collections request account so you can  place requests for collection material and make appointments.\n"},{"text":"How to Request Materials ","to":"/find-borrow-request/access-special-collections-materials/how-request-materials","description":"Find options and instructions for requesting different types of collection material for onsite use or duplication.\n"},{"text":"Use Materials Onsite","to":"/find-borrow-request/access-special-collections-materials/use-materials-onsite","description":"Learn about requesting materials for use in our reading room, making appointments, and expectations during your visit.\n"},{"text":"Guidance for Using Reproductions","to":"/find-borrow-request/access-special-collections-materials/guidance-using-reproductions","description":"Let us know about your planned use, find out how to cite our materials, and learn about publishing texts from our papyri collection.\n"}]},{"text":"Recommend a Purchase","to":"/find-borrow-request/recommend-purchase","description":"Request or make recommendations for items to add to our collection.\n"},{"text":"Access Online Resources","to":"/find-borrow-request/access-online-resources","description":"Gain on and off-campus access to extensive online resources through the library.\n","children":[{"text":"On Campus","to":"/find-borrow-request/access-online-resources/campus","description":"How to access online library resources while on campus.\n"},{"text":"Remote Access","to":"/find-borrow-request/access-online-resources/remote-access","description":"Take advantage of online library resources no matter where you’re working.\n","children":[{"text":"Using a Browser Extension","to":"/find-borrow-request/access-online-resources/remote-access/using-browser-extension","description":"Install the Lean Library browser extension to automatically detect content the library subscribes to.\n"},{"text":"Using a Browser Bookmark","to":"/find-borrow-request/access-online-resources/remote-access/using-browser-bookmark","description":"Add the Proxy Server Bookmarklet to check whether you have library access to content."}]}]}]},{"text":"Visit and Study","to":"/visit-and-study","description":"Find out what's happening at the library, from our best study spots to where you can get creative, fuel up, relax, or learn something new.\n","children":[{"text":"Study Spaces","to":"/visit-and-study/study-spaces","description":"Use Find a Study Space to filter by building, noise level, and features, or browse by type of space.\n","children":[{"text":"Find a Study Space","to":"/visit-and-study/study-spaces/find-study-space","description":"See a list of all our study spaces and filter it by building, noise level, and features to find your ideal spot.\n"},{"text":"Bookable Study Spaces","to":"/visit-and-study/study-spaces/bookable-study-spaces","description":"Reserve a space — options include rooms, carrels, and booths — for independent or group work.\n","children":[{"text":"Hatcher South Bookable Daily Carrels","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-south-bookable-daily-carrels","description":"Cubicles for one that can be reserved in advance.\n"},{"text":"Hatcher South Bookable Weekly Carrels","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-south-bookable-weekly-carrels","description":"Donor-furnished cubicles for individual study that can be reserved for up to a week.\n"},{"text":"Hatcher South Long-term Research Carrels","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-south-long-term-research-carrels","description":"Semester-long carrel reservations for U-M graduate students and faculty.\n"},{"text":"Hatcher Bookable Carrel Guidelines","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-bookable-carrel-guidelines","description":"Information about keys, use, maintenance, and security for weekly and semester-long reservations.\n"},{"text":"Hatcher North 212A","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-north-212a","description":"Glassed-in space near the center of the floor for solo or small group work.\n"},{"text":"Shapiro Bookable Study Rooms","to":"/visit-and-study/study-spaces/bookable-study-spaces/shapiro-bookable-study-rooms","description":"Rooms for groups on the second and third floors with adjustable tables, rolling chairs, and whiteboards.\n"},{"text":"Soundproof Booths","to":"/visit-and-study/study-spaces/bookable-study-spaces/soundproof-booths","description":"Reservable booths for sound privacy.\n"},{"text":"Hatcher and Shapiro Bookable Study Room and Booth Guidelines","to":"/visit-and-study/study-spaces/bookable-study-spaces/hatcher-and-shapiro-bookable-study-room-and","description":"Guidelines around reservation maximums, required check in, and cleanup expectations for certain bookable spaces.\n"},{"text":"Duderstadt Center Interview Rooms","to":"/visit-and-study/study-spaces/bookable-study-spaces/duderstadt-center-interview-rooms","description":"Small rooms you can book up to 3 days in advance.\n"},{"text":"Fine Arts Library Carrels","to":"/visit-and-study/study-spaces/bookable-study-spaces/fine-arts-library-carrels","description":"Reserved for graduate students in history of art.\n"},{"text":"Music Library Carrels","to":"/visit-and-study/study-spaces/bookable-study-spaces/music-library-carrels","description":"Intended for advanced research and writing.\n"}]},{"text":"Conversational Study Spaces","to":"/visit-and-study/study-spaces/conversational-study-spaces","description":"Meet for a group project, engage with others while you study, or study alone in a more talkative area.\n","children":[{"text":"Clark Commons Computing Spaces","to":"/visit-and-study/study-spaces/conversational-study-spaces/clark-commons-computing-spaces","description":"Seating areas with a mix of external monitor options, plus a campus computing site.\n"},{"text":"Bert's Study Lounge","to":"/visit-and-study/study-spaces/conversational-study-spaces/berts-study-lounge","description":"A café-like atmosphere with mixed seating, good for individual study or group meetings.\n"},{"text":"Shapiro Floor 1","to":"/visit-and-study/study-spaces/conversational-study-spaces/shapiro-floor-1","description":"A large open area with a variety of seating options and tables, plus vending machines.\n"},{"text":"Shapiro Floor 2","to":"/visit-and-study/study-spaces/conversational-study-spaces/shapiro-floor-2","description":"Rectangular tables and wooden chairs for working in groups or alone near others.\n"},{"text":"Clark Commons Seating Areas","to":"/visit-and-study/study-spaces/conversational-study-spaces/clark-commons-seating-areas","description":"An open and active space with lots of light and a mix of seating options for individual and group study.\n"},{"text":"Art, Architecture, and Engineering Library Floor 2 Computing Spaces","to":"/visit-and-study/study-spaces/conversational-study-spaces/art-architecture-and-engineering-library-floor-2-computing-spaces","description":"Connect to an external monitor or work with a group at a VizHub in this mixed seating space.\n"}]},{"text":"Low Noise Study Spaces","to":"/visit-and-study/study-spaces/low-noise-study-spaces","description":"Study solo or in a small group with background noise and some talking.\n","children":[{"text":"International Studies Reading Room","to":"/visit-and-study/study-spaces/low-noise-study-spaces/international-studies-reading-room","description":"A small, tucked away reading room for individual or group study near the Hatcher North lobby.\n"},{"text":"Hatcher North Floor 2","to":"/visit-and-study/study-spaces/low-noise-study-spaces/hatcher-north-floor-2","description":"An open floor with a range of seating options and regular traffic passing through.\n"},{"text":"Clark Library Seating Area","to":"/visit-and-study/study-spaces/low-noise-study-spaces/clark-library-seating-area","description":"Couches, armchairs, and tables between windows and exhibit cases.\n"},{"text":"Shapiro Basement","to":"/visit-and-study/study-spaces/low-noise-study-spaces/shapiro-basement","description":"Movable tables and chairs in open areas, plus a CAEN Lab.\n"},{"text":"Shapiro Floor 4","to":"/visit-and-study/study-spaces/low-noise-study-spaces/shapiro-floor-4","description":"Table seating, mostly in windowed nooks, on a quieter floor that’s good for working alone.\n"},{"text":"Art, Architecture, and Engineering Library Floor 2 Lobby Spaces","to":"/visit-and-study/study-spaces/low-noise-study-spaces/art-architecture-and-engineering-library-floor-2-lobby-spaces","description":"Natural light brightens this space with seating at tables amongst a variety of low profile stacks.\n"},{"text":"Art, Architecture, and Engineering Library Floor 3 ","to":"/visit-and-study/study-spaces/low-noise-study-spaces/art-architecture-and-engineering-library-floor-3","description":"Choose from a variety of seating options, including study pods and large tables.\n"}]},{"text":"Quiet Study Spaces","to":"/visit-and-study/study-spaces/quiet-study-spaces","description":"Focus on getting work done in quieter areas of our library buildings.\n","children":[{"text":"Hatcher Reference Reading Room","to":"/visit-and-study/study-spaces/quiet-study-spaces/hatcher-reference-reading-room","description":"Historic space in Hatcher North that's well-known for quiet, individual study.\n"},{"text":"Asia Library Reading Room","to":"/visit-and-study/study-spaces/quiet-study-spaces/asia-library-reading-room","description":"A mixture of seating and the Oka Tadoku Room make up this cozy, light-filled space in Hatcher North.\n"},{"text":"Hatcher North Stacks Study Tables","to":"/visit-and-study/study-spaces/quiet-study-spaces/hatcher-north-stacks-study-tables","description":"Out-of-the-way spots in the book stacks on 7 different floors.\n"},{"text":"Hatcher South Open Carrels","to":"/visit-and-study/study-spaces/quiet-study-spaces/hatcher-south-open-carrels","description":"Cubicles for one with a desk and window.\n"},{"text":"Hatcher South Designated SSD Carrels","to":"/visit-and-study/study-spaces/quiet-study-spaces/hatcher-south-designated-ssd-carrels","description":"Designated, enclosed carrels for Services for Students with Disabilities connected students.\n"},{"text":"Hatcher Floor 6","to":"/visit-and-study/study-spaces/quiet-study-spaces/hatcher-floor-6","description":"Lounge-like study areas with views of the Law Quad and Michigan Stadium.\n"},{"text":"Shapiro Reading Room","to":"/visit-and-study/study-spaces/quiet-study-spaces/shapiro-reading-room","description":"Long tables with padded chairs and a mix of other seating, all for individual, focused study.\n"},{"text":"Taubman Health Sciences Library Study Space","to":"/visit-and-study/study-spaces/quiet-study-spaces/taubman-health-sciences-library-study-space","description":"A wide variety of seating options, plus computing, in a light-filled space for focused work.\n"},{"text":"Art, Architecture, and Engineering Library Floor 2 Stacks Spaces","to":"/visit-and-study/study-spaces/quiet-study-spaces/art-architecture-and-engineering-library-floor-2-stacks-spaces","description":"Find a quiet spot among the stacks or in a tucked away corner window.\n"},{"text":"Fine Arts Library Floor 2","to":"/visit-and-study/study-spaces/quiet-study-spaces/fine-arts-library-floor-2","description":"High ceilings and tables surrounded by books.\n"},{"text":"Music Library Floors 3 and 4","to":"/visit-and-study/study-spaces/quiet-study-spaces/music-library-floors-3-and-4","description":"A quiet airy space with tables with a mix of seating for individuals and groups.\n"}]},{"text":"Student Parent and Caregiver Study Room","to":"/visit-and-study/study-spaces/student-parent-and-caregiver-study-room","description":"A study room for student parents and caregivers.\n"}]},{"text":"Creation and Learning Spaces ","to":"/visit-and-study/creation-and-learning-spaces","description":"Work on digital projects, get help from a peer tutor, and design and produce models, art, music, and more in our labs and studios.\n","children":[{"text":"Shapiro Design Lab","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab","description":"Dive into projects with hands-on access to creative tools and expertise.\n","children":[{"text":"Our Work","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/our-work","description":"Learn about our initiatives related to accessibility, community science, and more.\n","children":[{"text":"Our Principles","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/our-work/our-principles","description":"Principles that guide and inform the commitment of our staff, time, labor, and resources.\n"}]},{"text":"Workshop","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/workshop","description":"Get creative with our 3D printers, die cutters, engraving machine, and other hands-on equipment.\n"},{"text":"Media Production Rooms","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/media-production-rooms","description":"High-quality media production and post-production software and equipment.\n","children":[{"text":"Perlstein Editing Room","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/media-production-rooms/perlstein-editing-room","description":"Equipment available for audio recording, podcast production, and video post-production, including a podcasting table.\n"},{"text":"Video Production Room","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/media-production-rooms/video-production-room","description":"An intimate video production space for small interviews, podcasting, and still image shoots. Professional video cameras available upon request.\n"},{"text":"Winberg Audio Production Room","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/media-production-rooms/winberg-audio-production-room","description":"Professional space to record audio, create podcasts, and produce music. Includes an isolation booth, MIDI keyboard, and other music production tools upon request.\n"}]},{"text":"PIE Space","to":"/visit-and-study/creation-and-learning-spaces/shapiro-design-lab/pie-space","description":"Meet for a group project and get inspired in this open workspace.\n"}]},{"text":"Sweetland Peer Writing Center","to":"/visit-and-study/creation-and-learning-spaces/sweetland-peer-writing-center","description":"Get research support and writing help from fellow students in a consulting space at the library.\n"},{"text":"Book Arts Studio","to":"/visit-and-study/creation-and-learning-spaces/book-arts-studio","description":"Access letterpress machines and other bookmaking supplies.\n"},{"text":"Conservation Lab","to":"/visit-and-study/creation-and-learning-spaces/conservation-lab","description":"Conservation and book repair staff offer lectures, workshops, class visits, and more by appointment.\n","children":[{"text":"Our Work","to":"/visit-and-study/creation-and-learning-spaces/conservation-lab/our-work","description":"Learn more about what materials we preserve and conserve, and why, plus insights on how we work.\n"}]},{"text":"Digital Conversion Unit","to":"/visit-and-study/creation-and-learning-spaces/digital-conversion-unit","description":"Get advice and practical strategies on digitizing flat and time-based media.\n"},{"text":"Digital Preservation Lab","to":"/visit-and-study/creation-and-learning-spaces/digital-preservation-lab","description":"Get advice and practical strategies on preserving your born-digital content.\n"},{"text":"Library Instruction Rooms","to":"/visit-and-study/creation-and-learning-spaces/library-instruction-rooms","description":"Spaces that host library events and library instruction for classes and through workshops.\n"}]},{"text":"Cafés and Well-being","to":"/visit-and-study/cafes-and-well-being","description":"Need a break? We have spaces to help you refresh, reflect, and recharge.\n","children":[{"text":"Cafés","to":"/visit-and-study/cafes-and-well-being/cafes","description":"See where to fuel up onsite.\n"},{"text":"Reflection Rooms","to":"/visit-and-study/cafes-and-well-being/reflection-rooms","description":"Find space for quiet reflection, prayer, and meditation.\n"},{"text":"Well-being Rooms","to":"/visit-and-study/cafes-and-well-being/well-being-rooms","description":"Pause from studying and take a break in our well-being rooms.\n"},{"text":"Lactation Rooms","to":"/visit-and-study/cafes-and-well-being/lactation-rooms","description":"Find lactation rooms and resources.\n"},{"text":"Changing Tables","to":"/visit-and-study/cafes-and-well-being/changing-tables","description":"Locate baby changing areas.\n"}]},{"text":"Computing and Technology","to":"/visit-and-study/computing-and-technology","description":"Access our computers, get signed on, locate library printers and copiers, and more.\n","children":[{"text":"Computing","to":"/visit-and-study/computing-and-technology/computing","description":"Find a library computer, or connect to a wireless network.\n"},{"text":"Printing, Scanning, Copying","to":"/visit-and-study/computing-and-technology/printing-scanning-copying","description":"Locate and use library printers, scanners, and copiers.\n"},{"text":"Guest Computing and Printing","to":"/visit-and-study/computing-and-technology/guest-computing-and-printing","description":"Just visiting? Find out how you can use our computing services.\n"},{"text":"Specialized Technology","to":"/visit-and-study/computing-and-technology/specialized-technology","description":"Use microfilm readers, high-powered visualization systems, listening stations, and more.\n","children":[{"text":"Anatomage Table","to":"/visit-and-study/computing-and-technology/specialized-technology/anatomage-table","description":"This operating-bed sized table provides highly accurate, 3D visualizations of human and animal anatomy.\n"},{"text":"Microform Readers and Scanners ","to":"/visit-and-study/computing-and-technology/specialized-technology/microform-readers-and-scanners","description":"Use equipment to read, scan, or print microform content.\n"}]}]},{"text":"Events and Exhibits","to":"/visit-and-study/events-and-exhibits","description":"See what events are happening across the library and where to find our exhibits.\n","children":[{"text":"Today and Upcoming","to":"/visit-and-study/events-and-exhibits/today-and-upcoming","description":"See our upcoming events. All are free and open to the public.\n"},{"text":"Online Exhibits","to":"/visit-and-study/events-and-exhibits/online-exhibits","description":"Explore&nbsp;online exhibits curated using items from our collections.\n"},{"text":"Annual Events and Series","to":"/visit-and-study/events-and-exhibits/annual-events-and-series","description":"Learn about recurring library events, from talks and engagement on Martin Luther King, Jr. Day to event series on specialized topics.\n","children":[{"text":"Café Shapiro","to":"/visit-and-study/events-and-exhibits/annual-events-and-series/cafe-shapiro","description":"Readings by select undergraduate student writers.\n"},{"text":"China Ongoing Perspectives (CHOP) Film Screenings","to":"/visit-and-study/events-and-exhibits/annual-events-and-series/china-ongoing-perspectives-chop-film","description":"Documentary screenings and discussions exploring contemporary China through diverse lived experiences.\n"},{"text":"Deep Dive into Digital and Data Methods for Chinese Studies","to":"/visit-and-study/events-and-exhibits/annual-events-and-series/deep-dive-digital-and-data-methods","description":"Local experts and international scholars delve into digital scholarship and data research methods for Chinese studies.\n"},{"text":"MLK Day","to":"/visit-and-study/events-and-exhibits/annual-events-and-series/mlk-day","description":"We welcome an esteemed keynote speaker each year as part of the university’s broader MLK Day celebration.\n"},{"text":"Third Thursdays at the Library","to":"/visit-and-study/events-and-exhibits/annual-events-and-series/third-thursdays-library","description":"Themed monthly open houses sharing materials from our collections.\n"}]},{"text":"Gallery and Event Spaces","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces","description":"Places to gather, learn, and discover what’s happening at the library.\n","children":[{"text":"Hatcher Gallery Event Space","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/hatcher-gallery-event-space","description":"Attend lectures, performances, workshops, and more, or come here to study when events aren't taking place.\n"},{"text":"Hatcher Gallery Exhibit Space","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/hatcher-gallery-exhibit-space","description":"Get a glimpse of library collections and campus research.\n"},{"text":"Hatcher Gallery Exhibit Room","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/hatcher-gallery-exhibit-room","description":"Visit exhibits delving deeply into a variety of themes, time periods, and document types, drawing on our library's rich and varied collections.\n","children":[{"text":"The Birds of America","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/hatcher-gallery-exhibit-room/birds","description":"This first purchase for the library shows birds life sized and in their native habitats.\n"}]},{"text":"Hatcher North Lobby Cases","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/hatcher-north-lobby-cases","description":"Learn about library collections and student and faculty projects.\n"},{"text":"Clark Library Exhibit Space","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/clark-library-exhibit-space","description":"See maps, artwork, and other items that reflect on the geography, history, and cultures of the world.\n"},{"text":"Special Collections Exhibit Space","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/special-collections-exhibit-space","description":"Get close to unique, rare, and primary source materials in this pocket-sized exhibit space.\n"},{"text":"Shapiro Gallery","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/shapiro-gallery","description":"A multipurpose space available to support short-term exhibits and student engagement initiatives.\n"},{"text":"Directions to the Hatcher Gallery","to":"/visit-and-study/events-and-exhibits/gallery-and-event-spaces/directions-hatcher-gallery","description":"How to get to the gallery located in Hatcher North, including directions from the accessible Hatcher South entrance.\n"}]}]},{"text":"Floor Plans","to":"/visit-and-study/floor-plans","description":"Navigate our buildings with illustrated maps of each floor.\n","children":[{"text":"Hatcher Library North Floors","to":"/visit-and-study/floor-plans/hatcher-library-north-floors","description":"The north building has a basement, 4 main floors, and 5 sublevels that are mostly book stacks.&nbsp;\n","children":[{"text":"Basement","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/basement","description":"The following spaces are labeled in a clockwise direction from at the top of the page, which is the north end of the building:\nStaff space*, east elevators, book stacks for call numbers HD 8000 to HE, center elevator, study space, book stacks for HE to HJ, a library staff women’s restroom with a lactation room, main elevators, and an accessible men’s restroom.&nbsp;\nThe full range of call numbers on this floor is HD 8000 to HJ.&nbsp;"},{"text":"Basement A","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/basement-0","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nBook stacks for call numbers HB to HC, east elevators, study space, book stacks for H to HB, center elevator, book stacks for HC, study space, book stacks for HC to HD 7999.&nbsp;\nThe full range of call numbers on this floor is H to HD 7999.&nbsp;\n"},{"text":"Floor 1","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-1","description":"When entering the library at this north entrance (off the Diag), the east (left) pedestrian ramp meets Americans with Disabilities Act standards for steepness and surface condition, but the west ramp does not. You can also use the accessible entrance at floor 1 of Hatcher South.\nThe Information Services desk is on your right when you enter the building. The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building and entrance:"},{"text":"Floor 1A","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-1a","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nBook stacks for call numbers U to VM and HM to HN, east elevators, staff space*, book stacks for call numbers Q to TX, center elevator, study space, and book stacks for call numbers HQ to HX. The full range of call numbers on this floor is HM to HX and Q to VM.\n*Nonpublic space\n"},{"text":"Floor 2","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-2","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nReference Reading Room, study space, Reference Office*, Hatcher 206, study space 212a, access to book stacks for call numbers Z 1200 to ZA, east elevators, staff space*, center elevator, entrance to Hatcher South, computing site with printing, staff space*, overhead scanner, Serials and Microforms with staff space*, and main elevators."},{"text":"Floor 2A","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-2a","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nEast elevators, book stacks for call numbers Z 1 to Z 1199 with study space, and center elevator.\n"},{"text":"Floor 3","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-3","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nStaff space*, women’s and men's restrooms, staff space*, east elevators, study space, Asia Library book stacks for call numbers AC to BL with study space and no access to the rest of the floor, and main elevators.\n*Nonpublic space\n"},{"text":"Floor 3A","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-3a","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nEast elevators, Asia Library book stacks for call numbers BM to DS 856.7, and center elevator.\n"},{"text":"Floor 4","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-4","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nStaff space*, east elevators, Asia Library book stacks for call numbers DS 856.72 to TX with study space and entrance to Hatcher South, quiet study room, Asia Library Reading Room and Oka Tadoku Room, staff space*, main elevators, Asia Library office, and staff space*.\n*Nonpublic space\n"},{"text":"Floor 4A","to":"/visit-and-study/floor-plans/hatcher-library-north-floors/floor-4a","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nEast elevators, book stacks for call numbers B to BX with study space around the perimeter, and center elevator.\n"}]},{"text":"Hatcher Library South Floors","to":"/visit-and-study/floor-plans/hatcher-library-south-floors","description":"The south building has 8 floors with book stacks, staff spaces and offices, a range of study spaces, and areas dedicated to special collections.&nbsp;\n","children":[{"text":"Floor 1","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-1","description":"Accessible entry level of south building with the Information Services desk on your left when you enter. Elevators provide access to floors 1-8 of Hatcher South. Take the elevator to floor 2 to access Hatcher North. The northernmost elevator, closest to the back wall, also provides access to the book stacks in Hatcher North via floors 2A, 3A, and 4A.\n"},{"text":"Floor 2","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-2","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nEntrance to Hatcher North, elevators, women's and men's restrooms, entrance to the Clark Library, exhibit space, staff space*, computing site, staff space*, access to connector bridge to floor 3 of Shapiro Library, staff space*, study space, atlas cases A to Z, Information Services desk, computing site, map cases (see staff for access), government document books A to Z, Clark Library Presentation Space, staff space*.\n*Nonpublic space\n"},{"text":"Floor 3","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-3","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nElevators, women's restroom, accessible gender inclusive restroom, men's restroom, bookable study carrels that wrap around the floor, book stacks for call numbers 800 to 899 with Children's Literature in the center, and books stacks continuing for call numbers C to DC.\n"},{"text":"Floor 4","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-4","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nElevators, women's restroom, accessible gender inclusive restroom, men's restroom, SSD Carrel, study carrels (select carrels are bookable), Reflection Room, book stacks for call numbers P to PM and PQ to PZ, SSD Carrel.\n"},{"text":"Floor 5","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-5","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nElevators, women's restroom, accessible gender inclusive restroom, men's restroom, SSD Carrel, study carrels (select carrels are bookable), and book stacks for call numbers DD to F, SSD Carrel.\n"},{"text":"Floor 6","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-6","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nElevators, women’s restroom, accessible gender inclusive restroom, men’s restroom, access to the Special Collections Research Center and its reading room, classroom space, staff space, and study space, books stacks for call numbers BF to GV and G 350\\L-NX, and bookable study carrels.\n"},{"text":"Floor 7","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-7","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nElevators, women’s restroom, men’s restroom, and staff space*.\n*Nonpublic\n"},{"text":"Floor 8","to":"/visit-and-study/floor-plans/hatcher-library-south-floors/floor-8","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nElevators, women's and men's restrooms, conference room 806*, Papyrology*, library administration and staff offices*, and Finance, Library Human Resources, and Organizational Development*.\n*Nonpublic space\n"}]},{"text":"Shapiro Library Floors","to":"/visit-and-study/floor-plans/shapiro-library-floors","description":"A basement level and 4 floors with many different types of spaces.\n","children":[{"text":"Basement","to":"/visit-and-study/floor-plans/shapiro-library-floors/basement","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;"},{"text":"Floor 1","to":"/visit-and-study/floor-plans/shapiro-library-floors/floor-1","description":"Accessible entry level of Shapiro Library with automatic doors at the northeast entrance. The Information Services desk is in the center of the north end of the floor when you enter the building. The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;"},{"text":"Floor 2","to":"/visit-and-study/floor-plans/shapiro-library-floors/floor-2","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;"},{"text":"Floor 2 Group Study Rooms","to":"/visit-and-study/floor-plans/shapiro-library-floors/floor-2-group-study-rooms","description":"The bookable group study rooms on floor 2 of the Shapiro Library are located in the southwest corner. The Sweetland Center for Writing is at the north end of the rooms and book stacks for call numbers P through PR are to the east.\nStudy rooms are numbered as follows starting in the northeast corner and going clockwise: 2144, 2138, 2136, 2130, 2128, 2122, 2124, 2126, 2132, 2134, 2140, 2142."},{"text":"Floor 3","to":"/visit-and-study/floor-plans/shapiro-library-floors/floor-3","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:"},{"text":"Floor 4","to":"/visit-and-study/floor-plans/shapiro-library-floors/floor-4","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;"}]},{"text":"Art, Architecture, and Engineering Library Floors","to":"/visit-and-study/floor-plans/art-architecture-and-engineering-library-floors","description":"Located in the Duderstadt Center at the basement level and floors 1, 2, and 3.\n","children":[{"text":"Basement","to":"/visit-and-study/floor-plans/art-architecture-and-engineering-library-floors/basement","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nMain elevators, Fabrication Studio, east women's and men's restrooms, multipurpose space, west women's and men's restrooms, computing site with printing, study room, the Carillon Practice Room, and Art, Architecture, and Engineering Library Special Collections.\n"},{"text":"Floor 1","to":"/visit-and-study/floor-plans/art-architecture-and-engineering-library-floors/floor-1","description":"The following spaces are labeled in a clockwise direction from the top of the page and the building's main entrance, which is the north west end of the building:\nMain entrance, printing, main elevators, Duderstadt Center information desk, Mujo Café dining and study spaces, non-library Duderstadt Center spaces around the perimieter, east elevators, east women’s and men’s restrooms, study space, west women's and men's restrooms, west elevators, the hallway to Pierpont Commons, and study space.\n"},{"text":"Floor 2","to":"/visit-and-study/floor-plans/art-architecture-and-engineering-library-floors/floor-2","description":"The Information Services desk is in the center of the floor. The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:"},{"text":"Floor 3","to":"/visit-and-study/floor-plans/art-architecture-and-engineering-library-floors/floor-3","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nOpen to below, computing site with printing, east elevators, east women's and men's restrooms, computing site with printing, non-library Duderstadt Center spaces, computing site with printing, west women’s and men’s restrooms, west elevators, computing site with printing, study spaces, and book stacks for call numbers A to N and N to NA.\n"}]},{"text":"Taubman Health Sciences Library Layout","to":"/visit-and-study/floor-plans/taubman-health-sciences-library-layout","description":"The library is located at the street level entrance (floor 4) of the building, which is shared is the U-M Medical School.\n"},{"text":"Buhr Building Floors","to":"/visit-and-study/floor-plans/buhr-building-floors","description":"Mostly closed book stacks, along with staff spaces and offices, including for specialized conservation.\n","children":[{"text":"Floor 1","to":"/visit-and-study/floor-plans/buhr-building-floors/floor-1","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the east end of the building:\nClosed stacks*, Pub Hub*, Digital Conversion Unit*, elevator, men’s and women’s restrooms, and more closed stacks* in the north end of the building (not pictured). HathiTrust offices (not pictured) are accessible via a separate entrance for the north wing of the building.\n*Nonpublic space\n"},{"text":"Floor 3","to":"/visit-and-study/floor-plans/buhr-building-floors/floor-3","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the east end of the building:\nClosed stacks*, staff space*, Conservation Lab, elevator, more closed stacks* in the north end of the building (not pictured), Digital Preservation Lab, closed stacks*, and Bindery Prep*.\n*Nonpublic space&nbsp;\n"}]},{"text":"Fine Arts Library Floors","to":"/visit-and-study/floor-plans/fine-arts-library-floors","description":"Located on floors 1 and 2 of Tappan Hall.\n","children":[{"text":"Floor 1","to":"/visit-and-study/floor-plans/fine-arts-library-floors/floor-1","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:&nbsp;\nMen’s restroom, emergency exits, and elevator, computing site, open book stacks for call numbers NB to NX, oversize and folio for call numbers A to NA and NB to ND, journals A to Z, open books stacks for call numbers NX to Z, and computing site.\n"},{"text":"Floor 2","to":"/visit-and-study/floor-plans/fine-arts-library-floors/floor-2","description":"The Information Services desk is directly in front of you when you enter the library space. The following spaces are labeled in a clockwise direction from the top of the page, which is the north end of the building:\nGraduate student study carrels, study space, LSA classroom, women's restroom, elevator, staff space*, current journals and new books, study space, computing site, open book stacks for call numbers B to NA and A to B, reference, study space, staff space* behind the Information Services desk, and another LSA classroom.\n*Nonpublic space\n"}]},{"text":"Music Library Floors","to":"/visit-and-study/floor-plans/music-library-floors","description":"Located on floors 3, 4, and 5 of the Earl V. Moore Building.\n","children":[{"text":"Floor 3","to":"/visit-and-study/floor-plans/music-library-floors/floor-3","description":"The Information Services desk is on your right when you enter the library space. The following spaces are labeled in a clockwise direction from the top of the page, which is the east end of the building:\nStudy space, current periodicals, stacks for reference books with call numbers BV to ML and ML to Z, study space, the Glenn Watkins Seminar Room, staff space* behind the Information Services desk, women’s and men’s restrooms and elevator (outside the library entrance), hallway to Faculty Studios, Music Library entrance, new items, and computing site with printing."},{"text":"Floor 4","to":"/visit-and-study/floor-plans/music-library-floors/floor-4","description":"The following spaces are labeled in a clockwise direction from the top of the page, which is the east end of the building:&nbsp;\nStacks for call number M, oversize materials, study space, study carrels, stacks for call numbers M to ML, study carrels, study space, open to below in center of the floor, miniature scores, stacks for call numbers AC to M.\n"},{"text":"Floor 5","to":"/visit-and-study/floor-plans/music-library-floors/floor-5","description":"This floor is dedicated to stacks for call numbers ML to Z. The east end of the floor (top of the page) is open to below.\n"}]}]},{"text":"Information Desks","to":"/visit-and-study/information-desks","description":"Get help finding your way from staff at one of our many service desks.\n"}]},{"text":"Research and Scholarship","to":"/research-and-scholarship","description":"Whether it's your research, coursework, instruction, or all three, you've got work to do —&nbsp;and we're here to help make it better.\n","children":[{"text":"Help with Research","to":"/research-and-scholarship/help-research","description":"Get support for all stages of your research — from the planning stage to funding strategies, help with citations, and sharing and preserving your work.\n","children":[{"text":"Find a Specialist","to":"/research-and-scholarship/help-research/find-specialist","description":"Search by subject or specialty to find experts who can offer guidance.\n"},{"text":"Use Research Guides","to":"/research-and-scholarship/help-research/use-research-guides","description":"Find how-tos and resources by academic subject, course, or special research skill area.\n"},{"text":"How We Can Help","to":"/research-and-scholarship/help-research/how-we-can-help","description":"Find out how you can get specialized support for your research from the library, from planning to preservation.\n"},{"text":"Citation Management","to":"/research-and-scholarship/help-research/citation-management","description":"Keep track of your sources and how to cite them.\n"},{"text":"Formatting Scholarly Work","to":"/research-and-scholarship/help-research/formatting-scholarly-work","description":"Get help formatting a research paper, case study, dissertation, or other scholarly work.\n"},{"text":"Non-English Research Support","to":"/research-and-scholarship/help-research/non-english-research-support","description":"Resources for doing work in many languages.\n"},{"text":"Funding and Grants","to":"/research-and-scholarship/help-research/funding-and-grants","description":"We can help you with strategies for finding funding at every stage of your research project.\n"},{"text":"Research Impact","to":"/research-and-scholarship/help-research/research-impact","description":"Build your scholarly profile and communicate the impact of your work.\n","children":[{"text":"Assess Your Impact in the Health Sciences","to":"/research-and-scholarship/help-research/research-impact/assess-your-impact-health-sciences","description":"Get help with health sciences-related impact metrics and tools.\n"}]},{"text":"Share and Preserve Your Work","to":"/research-and-scholarship/help-research/share-and-preserve-your-work","description":"Preserve your scholarly work in a discoverable digital repository.\n"},{"text":"Open Access Publishing Support","to":"/research-and-scholarship/help-research/open-access-publishing-support","description":"Take advantage of discounts on article publishing charges (APCs) in open access journals.\n"},{"text":"Publish with Us","to":"/research-and-scholarship/help-research/publish-us","description":"Our publishing services and press offer a variety of formats for publishing your scholarly work.\n"}]},{"text":"Instruction and Course Support","to":"/research-and-scholarship/instruction-and-course-support","description":"Teaching a course? We can help you find and share resources, design assignments, and lead instruction sessions in line with your course goals.\n","children":[{"text":"Request Instruction","to":"/research-and-scholarship/instruction-and-course-support/request-instruction","description":"Request an instruction session or get course support from library staff.\n","children":[{"text":"What We Teach","to":"/research-and-scholarship/instruction-and-course-support/request-instruction/what-we-teach","description":"We teach a wide variety of concepts and skills from finding, using, evaluating, and citing sources to exploring digital tools and topics or specific collections.\n"}]},{"text":"Get Course Design Help","to":"/research-and-scholarship/instruction-and-course-support/get-course-design-help","description":"Work with a library expert to design a course activity or project, include a research guide, or use an online module.\n"},{"text":"Use Recordings and Canvas Modules","to":"/research-and-scholarship/instruction-and-course-support/use-recordings-and-canvas-modules","description":"Take advantage of recorded library workshops or add our ready-made instruction modules to your course site in Canvas.\n"},{"text":"Get Course Materials","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials","description":"Partner with us to select course materials and ensure access for your students.\n","children":[{"text":"Use Electronic Items","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/use-electronic-items","description":"Find online items from our collections and familiarize yourself with ebook limitations.\n"},{"text":"Put Items on Physical Reserve","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/put-items-physical","description":"Use physical reserves for required readings with no electronic option or items in a specific format.\n","children":[{"text":"Checkout Locations","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/put-items-physical/checkout-locations","description":"Locations where you can check out and return course reserve items.\n"}]},{"text":"Use Film in Courses","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/use-film-courses","description":"Access and guidance for using films and streaming films in courses.\n"},{"text":"Create Links that Work","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/create-links-work","description":"Ensure students can access the links you provide to library materials.\n"},{"text":"Provide Access Through Canvas","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/provide-access-through","description":"Add links to course materials in Canvas, along with customized library resources.\n"},{"text":"Submit a Request","to":"/research-and-scholarship/instruction-and-course-support/get-course-materials/submit-request","description":"Get help finding and providing access to materials for your course.\n"}]}]},{"text":"Create and Design","to":"/research-and-scholarship/create-and-design","description":"Support and tools for starting a podcast, making 3D models, and more.\n","children":[{"text":"Produce Video","to":"/research-and-scholarship/create-and-design/produce-video","description":"Edit your video project at the library.\n"},{"text":"Produce Audio","to":"/research-and-scholarship/create-and-design/produce-audio","description":"Get help recording online course content, original podcasts and music, and more.\n"},{"text":"Make and Print 3D Models","to":"/research-and-scholarship/create-and-design/make-and-print-3d-models","description":"Access our 3D printing technology.\n"},{"text":"Use a Letterpress","to":"/research-and-scholarship/create-and-design/use-letterpress","description":"Create materials on a working letterpress.\n"}]},{"text":"Digital Scholarship","to":"/research-and-scholarship/digital-scholarship","description":"Access resources and support to help you plan, produce, and preserve your digital scholarship.\n","children":[{"text":"How We Support Digital Scholarship","to":"/research-and-scholarship/digital-scholarship/how-we-support-digital-scholarship","description":"An overview of our digital scholarship services and what you can expect working with us.\n","children":[{"text":"Understanding Digital Scholarship","to":"/research-and-scholarship/digital-scholarship/how-we-support-digital-scholarship/understanding","description":"What we mean when we use the term, and how it could be related to your scholarly work.\n"},{"text":"Principles Guiding Our Work","to":"/research-and-scholarship/digital-scholarship/how-we-support-digital-scholarship/principles-guiding","description":"Our digital scholarship support work is guided by standards rooted in the library's overall mission.\n"}]},{"text":"Request a Consultation","to":"/research-and-scholarship/digital-scholarship/request-consultation","description":"Make an appointment to discuss your digital scholarship project needs.\n","children":[{"text":"Support Levels","to":"/research-and-scholarship/digital-scholarship/request-consultation/support-levels","description":"View our different levels of service for supporting digital scholarship and digital projects.\n"}]},{"text":"Get Help with Funding Requests","to":"/research-and-scholarship/digital-scholarship/get-help-funding-requests","description":"Contact us for help coordinating your digital scholarship funding applications.\n"},{"text":"Connect with Us","to":"/research-and-scholarship/digital-scholarship/connect-us","description":"Build on your skills, engage in critical concepts, and meet people working on projects at office hours, events, and workshops.\n"}]},{"text":"Data Services","to":"/research-and-scholarship/data-services","description":"Discover resources and support to access, organize, visualize, and preserve research data.\n","children":[{"text":"Get the Data You Need","to":"/research-and-scholarship/data-services/get-data-you-need","description":"Find and access the data you need to conduct your research.\n"},{"text":"Geospatial Data and Mapping","to":"/research-and-scholarship/data-services/geospatial-data-and-mapping","description":"Get resources to help you work with geospatial data and GIS.\n","children":[{"text":"Support for GIS on Campus","to":"/research-and-scholarship/data-services/geospatial-data-and-mapping/support-gis-campus","description":"Additional GIS support beyond the library.\n"}]},{"text":"Make a Data Management Plan","to":"/research-and-scholarship/data-services/make-data-management-plan","description":"Planning for your data can save time and effort, and can help meet funder requirements.\n"},{"text":"Metadata Consultation","to":"/research-and-scholarship/data-services/metadata-consultation","description":"Get resources and support for creating good metadata.\n"},{"text":"Text and Data Mining","to":"/research-and-scholarship/data-services/text-and-data-mining","description":"Find text and data sets, plus tools and technologies, for text and data mining.\n"},{"text":"Data Visualization","to":"/research-and-scholarship/data-services/data-visualization","description":"Present your data in an illustrated or graphical format.\n"},{"text":"Share and Preserve your Data","to":"/research-and-scholarship/data-services/share-and-preserve-your-data","description":"Increase your impact by sharing the research data that supports your work.\n"}]},{"text":"Copyright Services","to":"/research-and-scholarship/copyright-services","description":"Get answers on copyright and fair use through our consultations, workshops and presentations, online resources, and more.\n","children":[{"text":"Connect with Us","to":"/research-and-scholarship/copyright-services/connect-us","description":"Make an appointment, email us, attend a workshop, and get other help.\n"},{"text":"Copyright and Teaching","to":"/research-and-scholarship/copyright-services/copyright-and-teaching","description":"Find resources and guidance for considering copyright concerns when selecting course materials.\n","children":[{"text":"Using Third-Party Materials for Online Classes","to":"/research-and-scholarship/copyright-services/copyright-and-teaching/using-third-party-materials","description":"Make informed decisions when using third-party materials for online classes by reviewing these considerations.\n"},{"text":"Copyright Basics Canvas Module","to":"/research-and-scholarship/copyright-services/copyright-and-teaching/copyright-basics-canvas-module","description":"Explore these adaptable modules that cover the basics of U.S. copyright law.\n"}]},{"text":"Our Advocacy","to":"/research-and-scholarship/copyright-services/our-advocacy","description":"View our public statements on copyright as it relates to scholarship, research, the library, and the university.\n"},{"text":"Guides","to":"/research-and-scholarship/copyright-services/guides","description":"Learn about copyright, fair use, Creative Commons, open access, scholarly publishing, and obtaining permission.\n","children":[{"text":"Copyright Scenarios","to":"/research-and-scholarship/copyright-services/guides/copyright-scenarios","description":"Learn about copyright concepts and considerations through our scenarios.\n"}]},{"text":"Copies Made by Libraries and Archives ","to":"/research-and-scholarship/copyright-services/copies-made-libraries-and-archives","description":"Request copies from the library as permitted by copyright law for uses such as teaching, scholarship, and research.\n"},{"text":"Forms","to":"/research-and-scholarship/copyright-services/forms","description":"Find useful forms and templates including gift agreements, release forms, addendas, and more.\n","children":[{"text":"Author’s Addenda","to":"/research-and-scholarship/copyright-services/forms/authors-addenda","description":"Addenda you can use when signing publishing agreements for articles and books to retain your author's rights.\n"},{"text":"Contract Request Letter","to":"/research-and-scholarship/copyright-services/forms/contract-request-letter","description":"Template letter for requesting a copy of your publishing agreement from your publisher.\n"},{"text":"Copyright and Oral History Interviews","to":"/research-and-scholarship/copyright-services/forms/copyright-and-oral-history-interviews","description":"Best practices and sample release forms for conducting oral history interviews.\n"},{"text":"Gift Agreements","to":"/research-and-scholarship/copyright-services/forms/gift-agreements","description":"Forms for U-M affiliates to use when working with donors.\n"},{"text":"Licensing Form","to":"/research-and-scholarship/copyright-services/forms/licensing-form","description":"A form for copyright holders to document that they’ve licensed a work under Creative Commons.\n"},{"text":"Rights Reversion","to":"/research-and-scholarship/copyright-services/forms/rights-reversion","description":"Form for requesting your copyright back in order to increase access to your scholarship.\n"},{"text":"Syllabus Statement","to":"/research-and-scholarship/copyright-services/forms/syllabus-statement","description":"Statement for instructors to include on their syllabi to inform their students about copyright and academic integrity.\n"}]}]},{"text":"Awards and Grants","to":"/research-and-scholarship/awards-and-grants","description":"We offer several funding opportunities to expand and enhance the scholarly work of students, faculty, and other researchers from across the university and beyond.\n","children":[{"text":"Anti-Racist Digital Research Institute","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute","description":"A mini-grant program and institute to support early-stage digital scholarship projects that advance social justice.\n","children":[{"text":"Program Details","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute/program-details","description":"What the program provides and the structure of the summer institute, including expected time commitments.\n"},{"text":"How to Apply","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute/how-apply","description":"Details for putting together a proposal and how we’ll evaluate submissions.\n"},{"text":"Support Provided","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute/support-provided","description":"Types of planning and expertise available to recipients.\n"},{"text":"Grant Funds","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute/grant-funds","description":"Ideas for how funds received may be used, including stipends, paying fees, purchasing equipment, and more.\n"},{"text":"Funded Projects","to":"/research-and-scholarship/awards-and-grants/anti-racist-digital-research-institute/funded-projects","description":"Awardees and descriptions of their funded projects.\n"}]},{"text":"Artists in the Archive","to":"/research-and-scholarship/awards-and-grants/artists-archive","description":"Support and funding for faculty engaged in creative practice with archival and special collections.\n"},{"text":"Library Data Grant Program","to":"/research-and-scholarship/awards-and-grants/library-data-grant-program","description":"Access the data you need to do your work.\n","children":[{"text":"Previous Winners","to":"/research-and-scholarship/awards-and-grants/library-data-grant-program/previous-winners","description":"Data sets acquired through our program.\n"}]},{"text":"Student Mini Grants","to":"/research-and-scholarship/awards-and-grants/student-mini-grants","description":"Funding and mentorship for projects with a real-world impact.\n","children":[{"text":"Requirements for Funding","to":"/research-and-scholarship/awards-and-grants/student-mini-grants/requirements-funding","description":"What a grant will cover and how you’ll receive the funds.\n"}]},{"text":"TOME Publishing Grant","to":"/research-and-scholarship/awards-and-grants/tome-publishing-grant","description":"Receive a publication subvention of up to $15,000 to support open access distribution of your work.\n","children":[{"text":"How to Apply","to":"/research-and-scholarship/awards-and-grants/tome-publishing-grant/how-apply","description":"Required application materials and how you'll be evaluated.\n"},{"text":"Award Notification and Distribution","to":"/research-and-scholarship/awards-and-grants/tome-publishing-grant/award-notification-and","description":"Expectations for notification about awards and the fund distribution process.\n"},{"text":"Funded Publications","to":"/research-and-scholarship/awards-and-grants/tome-publishing-grant/funded-publications","description":"List of publications that have received funding.\n"}]},{"text":"Undergraduate Research Awards","to":"/research-and-scholarship/awards-and-grants/undergraduate-research-awards","description":"Recognizing excellence in undergraduate research.\n","children":[{"text":"Details and Requirements","to":"/research-and-scholarship/awards-and-grants/undergraduate-research-awards/details-and-requirements","description":"Types of awards, as well as application requirements and tips.\n"},{"text":"Guidelines for Support Letter ","to":"/research-and-scholarship/awards-and-grants/undergraduate-research-awards/guidelines-support-letter","description":"What should be included in the letter from an instructor or supervisor that supports your research.\n"},{"text":"Recent Awards Winners","to":"/research-and-scholarship/awards-and-grants/undergraduate-research-awards/recent-awards-winners","description":"The most recent winners of the award and access to past winning work.\n"},{"text":"About Pam MacKintosh","to":"/research-and-scholarship/awards-and-grants/undergraduate-research-awards/about-pam-mackintosh","description":"Our annual awards program is named in honor of a former U-M librarian who championed student work.\n"}]},{"text":"Asia Library Travel Grants","to":"/research-and-scholarship/awards-and-grants/asia-library-travel-grants","description":"Apply for support to visit our collection in person.\n"},{"text":"Special Collections Research Fellowships","to":"/research-and-scholarship/awards-and-grants/special-collections-research-fellowships","description":"The Cohen, Heid, and Heidrich research fellowships provide awards for onsite research involving special collections materials.\n","children":[{"text":"How to Apply","to":"/research-and-scholarship/awards-and-grants/special-collections-research-fellowships/how-apply","description":"Eligibility for fellowships, the application and award timeline, and requirements for how to apply.\n"}]}]},{"text":"Library Workshops and Credit Courses","to":"/research-and-scholarship/library-workshops-and-credit-courses","description":"Take a library course for credit, attend a workshop, and get specialized training.\n","children":[{"text":"Drop-in Workshops","to":"/research-and-scholarship/library-workshops-and-credit-courses/drop-workshops","description":"Join one of our workshops on a variety of topics relevant to teaching, learning, and research.\n"},{"text":"Library Credit Courses","to":"/research-and-scholarship/library-workshops-and-credit-courses/library-credit-courses","description":"Get credit with a class  in data visualization, media analysis, and more.\n"},{"text":"International Data Workshop","to":"/research-and-scholarship/library-workshops-and-credit-courses/international-data-workshop","description":"Get in-depth training on providing statistics and geospatial data reference services.\n"},{"text":"Systematic Reviews Workshop","to":"/research-and-scholarship/library-workshops-and-credit-courses/systematic-reviews-workshop","description":"Develop your skills conducting systematic reviews in this hybrid course for health science librarians.\n","children":[{"text":"What You'll Learn","to":"/research-and-scholarship/library-workshops-and-credit-courses/systematic-reviews-workshop/what","description":"Get an overview of the content and objectives.\n"},{"text":"Registration and Fees  ","to":"/research-and-scholarship/library-workshops-and-credit-courses/systematic-reviews-workshop/registration-and-fees","description":"Information on the workshop fee and how to register.\n"}]},{"text":"The History of Bookbinding from 200 to 1900: A Structure-Based Perspective","to":"/research-and-scholarship/library-workshops-and-credit-courses/history-bookbinding-200-1900","description":"This five-day workshop explores the evolution of bookbinding structures from around the year 200. Applying to attend is required.\n","children":[{"text":"Workshop Content by Day","to":"/research-and-scholarship/library-workshops-and-credit-courses/history-bookbinding-200-1900/workshop","description":"What to expect each day of the workshop, including special lectures.\n"},{"text":"Recommended Readings","to":"/research-and-scholarship/library-workshops-and-credit-courses/history-bookbinding-200-1900/recommended-readings","description":"Recommended readings for workshop attendees.\n"}]}]}]},{"text":"Collections","to":"/collections","description":"Explore the vast array of materials we collect and maintain in all formats, from text and images to accessible research data.\n","children":[{"text":"Collecting Areas","to":"/collections/collecting-areas","description":"Discover how we build our collections, and the specialists who maintain each subject area.\n","children":[{"text":"Arts and Humanities","to":"/collections/collecting-areas/arts-and-humanities","description":"From history to museum studies, and architecture to film, music, philosophy, and more.\n","children":[{"text":"Architecture","to":"/collections/collecting-areas/arts-and-humanities/architecture","description":"Materials on architecture from the early 20th century to the present.\n"},{"text":"Art and Design","to":"/collections/collecting-areas/arts-and-humanities/art-and-design","description":"Supports research and practice in the field of art and design.\n"},{"text":"Children's Literature Collection","to":"/collections/collecting-areas/arts-and-humanities/childrens-literature-collection","description":"Children’s and young adult literature that includes picture books, early readers, and works by Michigan authors.\n"},{"text":"Classical Studies and Modern Greek","to":"/collections/collecting-areas/arts-and-humanities/classical-studies-and-modern-greek","description":"Covers classical antiquity to the current Greek world.\n"},{"text":"English Language and Literature","to":"/collections/collecting-areas/arts-and-humanities/english-language-and-literature","description":"English language literature from around the world, spanning all genres, critical approaches, and literary cultures.\n"},{"text":"Film, Television, and Media","to":"/collections/collecting-areas/arts-and-humanities/film-television-and-media","description":"Print, digital, video, and other materials supporting the study of film, television, and media.\n"},{"text":"General and Comparative Literature","to":"/collections/collecting-areas/arts-and-humanities/general-and-comparative-literature","description":"Materials in literary theory and criticism, comparative studies, and translation studies.\n"},{"text":"History","to":"/collections/collecting-areas/arts-and-humanities/history","description":"Materials documenting the history of world events and cultures.\n"},{"text":"History of Art","to":"/collections/collecting-areas/arts-and-humanities/history-art","description":"Materials supporting the study of art history.\n"},{"text":"Museum Studies","to":"/collections/collecting-areas/arts-and-humanities/museum-studies","description":"Materials for the museum studies community, to meet the needs of the Museum Studies program.\n"},{"text":"Music, Theatre, and Dance","to":"/collections/collecting-areas/arts-and-humanities/music-theatre-and-dance","description":"Materials supporting the study of music, theatre, and dance.\n"},{"text":"Philosophy","to":"/collections/collecting-areas/arts-and-humanities/philosophy","description":"Scholarly books, periodicals, and classic texts in original languages, with translations covering all philosophy areas.\n"},{"text":"Religious Studies","to":"/collections/collecting-areas/arts-and-humanities/religious-studies","description":"Representing all regions of the world, spanning historical periods and numerous languages.\n"},{"text":"Romance Languages and Literatures","to":"/collections/collecting-areas/arts-and-humanities/romance-languages-and-literatures","description":"Literary and linguistic studies of world regions speaking French, Italian, Spanish, and Portuguese.\n"}]},{"text":"Engineering","to":"/collections/collecting-areas/engineering","description":"Applied sciences, engineering, and technology, and aspects of entrepreneurship, including patents and trademarks, industry research, and more.\n","children":[{"text":"Engineering","to":"/collections/collecting-areas/engineering/engineering","description":"Current and historical materials covering applied sciences, engineering, and technology.\n"},{"text":"Entrepreneurship","to":"/collections/collecting-areas/engineering/entrepreneurship","description":"Covers business planning, industry research and marketing, patents and trademarks, standards, and more, for entrepreneurs.\n"}]},{"text":"Health Sciences ","to":"/collections/collecting-areas/health-sciences","description":"Research, academic, and clinical literature that support work in the health sciences.\n"},{"text":"International Studies","to":"/collections/collecting-areas/international-studies","description":"Materials supporting the study of countries, people, culture, and language from around the world.\n","children":[{"text":"Australia, New Zealand, and the Pacific Islands","to":"/collections/collecting-areas/international-studies/australia-new-zealand-and-pacific-islands","description":"Literature, history, and politics of the greater Pacific region, much in indigenous languages.\n"},{"text":"Chinese Studies","to":"/collections/collecting-areas/international-studies/chinese-studies","description":"Research materials on pre-modern, modern, and contemporary China.\n"},{"text":"French Studies","to":"/collections/collecting-areas/international-studies/french-studies","description":"History and social sciences pertaining to France and Francophone countries around the world.\n"},{"text":"Germanic Studies","to":"/collections/collecting-areas/international-studies/germanic-studies","description":"Materials in literature history, politics, philosophy, and more, representing Germany and much of northern Europe.\n"},{"text":"Iberian Studies","to":"/collections/collecting-areas/international-studies/iberian-studies","description":"Covers the history and social sciences pertaining to the Iberian Peninsula, which includes Spain and Portugal.\n"},{"text":"Japanese Studies","to":"/collections/collecting-areas/international-studies/japanese-studies","description":"A Japanese-language collection that supports research and education related to Japan in the humanities and social sciences.\n"},{"text":"Judaic Studies","to":"/collections/collecting-areas/international-studies/judaic-studies","description":"Humanities and social sciences materials in Hebrew, Yiddish, Ladino and Aramaic, and other Jewish languages, plus the Jewish Heritage Collection.\n"},{"text":"Korean Studies","to":"/collections/collecting-areas/international-studies/korean-studies","description":"South Korean and North Korean materials covering subjects in the social sciences and humanities.\n"},{"text":"Latin American and Caribbean studies","to":"/collections/collecting-areas/international-studies/latin-american-and-caribbean-studies","description":"Materials that support academic disciplines studying the countries, peoples, cultures, and languages of Latin America and the Caribbean.\n"},{"text":"Middle Eastern and North African Studies","to":"/collections/collecting-areas/international-studies/middle-eastern-and-north-african-studies","description":"Resources for studying the Middle East and North Africa from ancient to modern times.\n"},{"text":"Slavic, East European, and Eurasian Studies","to":"/collections/collecting-areas/international-studies/slavic-east-european-and-eurasian-studies","description":"Materials that support academic disciplines studying the array of Slavic, East European, and Eurasian countries, cultures, and languages.\n"},{"text":"South Asia Studies","to":"/collections/collecting-areas/international-studies/south-asia-studies","description":"Covers South Asia geographically and culturally, with holdings in more than 30 languages.\n"},{"text":"Southeast Asia","to":"/collections/collecting-areas/international-studies/southeast-asia","description":"Indigenous and western language publications centered in the humanities and social sciences.\n"},{"text":"Sub-Saharan Africa","to":"/collections/collecting-areas/international-studies/sub-saharan-africa","description":"Materials that support the study of Sub-Saharan Africa across disciplines.\n"}]},{"text":"Mathematics and Sciences","to":"/collections/collecting-areas/mathematics-and-sciences","description":"Supporting research in astronomy, statistics, chemistry, earth science, environmental science and sustainability, and more.\n","children":[{"text":"Biology and Natural History","to":"/collections/collecting-areas/mathematics-and-sciences/biology-and-natural-history","description":"Materials in the biological sciences at all levels of inquiry.\n"},{"text":"Chemistry","to":"/collections/collecting-areas/mathematics-and-sciences/chemistry","description":"Providing chemistry information, literature, and research across all aspects of the discipline.\n"},{"text":"Earth and Environmental Sciences","to":"/collections/collecting-areas/mathematics-and-sciences/earth-and-environmental-sciences","description":"Literature regarding the origin, evolution, and future of the Earth.\n"},{"text":"Environment and Sustainability","to":"/collections/collecting-areas/mathematics-and-sciences/environment-and-sustainability","description":"Collections supporting a wide range of environmental science and environmental policy specialties.\n"},{"text":"Mathematics and Statistics","to":"/collections/collecting-areas/mathematics-and-sciences/mathematics-and-statistics","description":"A comprehensive collection of mathematics and statistics materials, from historical books to modern electronic content.\n","children":[{"text":"Astronomy","to":"/collections/collecting-areas/mathematics-and-sciences/mathematics-and-statistics/astronomy","description":"Theoretical and descriptive works on astronomy that reflect the university’s research needs.\n"}]},{"text":"Physics","to":"/collections/collecting-areas/mathematics-and-sciences/physics","description":"Electronic and print collections supporting a wide range of research in physics.\n"}]},{"text":"Social Sciences","to":"/collections/collecting-areas/social-sciences","description":"Areas dedicated to human society and social relationships, from anthropology to urban planning.\n","children":[{"text":"Anthropology","to":"/collections/collecting-areas/social-sciences/anthropology","description":"Materials on general anthropology, archaeology, social anthropology, biological anthropology, and anthropological linguistics.\n"},{"text":"Communication and Media Studies","to":"/collections/collecting-areas/social-sciences/communication-and-media-studies","description":"Print, digital, video, and other materials supporting the study of communication and media.\n"},{"text":"Economics","to":"/collections/collecting-areas/social-sciences/economics","description":"Materials on economic history, banking, credit, development, econometrics, investment, applied economics, game theory, and labor.\n"},{"text":"Education","to":"/collections/collecting-areas/social-sciences/education","description":"Scholarly journals, monographs, and teacher preparation materials that support teaching and research.\n"},{"text":"Information Science","to":"/collections/collecting-areas/social-sciences/information-science","description":"Print, digital, video, and other materials supporting the study of information science.\n"},{"text":"Law and Legal Studies","to":"/collections/collecting-areas/social-sciences/law-and-legal-studies","description":"Supports the study of law as it relates to society.\n"},{"text":"LGBTQ Studies","to":"/collections/collecting-areas/social-sciences/lgbtq-studies","description":"Materials to support the study of sexuality from a variety of disciplines and methodologies.\n"},{"text":"Linguistics","to":"/collections/collecting-areas/social-sciences/linguistics","description":"Our linguistics collection spans disciplines and the globe, including resources in every language.\n"},{"text":"Multicultural Studies","to":"/collections/collecting-areas/social-sciences/multicultural-studies","description":"Contains materials related to African American, Latinx, Native American, Arab and Muslim American, and Asian/Pacific Islander American studies.\n"},{"text":"Political Science","to":"/collections/collecting-areas/social-sciences/political-science","description":"Covers the theory and structures of government and the analysis of political activity.\n"},{"text":"Psychology","to":"/collections/collecting-areas/social-sciences/psychology","description":"Materials related to the study of psychology, including theories, histories, methodologies, and research.\n"},{"text":"Public Policy","to":"/collections/collecting-areas/social-sciences/public-policy","description":"Resources covering domestic and foreign public policy and public affairs.\n"},{"text":"Social Work","to":"/collections/collecting-areas/social-sciences/social-work","description":"A multi-format collection supporting the research of privilege, oppression, diversity, and social justice.\n"},{"text":"Sociology","to":"/collections/collecting-areas/social-sciences/sociology","description":"Interdisciplinary collection of sociology materials.\n"},{"text":"Urban Planning","to":"/collections/collecting-areas/social-sciences/urban-planning","description":"Materials on the history of urban planning and design as well as transportation, urbanism, sustainability, land use, and more.\n"},{"text":"Women’s and Gender Studies","to":"/collections/collecting-areas/social-sciences/womens-and-gender-studies","description":"Materials that support the study of gender from a variety of disciplines and methodologies.\n"}]},{"text":"Special Collections","to":"/collections/collecting-areas/special-collections","description":"Rare, unique, and special materials in an array of subjects, from medieval manuscripts to classic children's books.\n","children":[{"text":"Art, Architecture, and Engineering Library Special Collections","to":"/collections/collecting-areas/special-collections/art-architecture-and-engineering-library-special","description":"Rare, fragile, and limited editions of materials related to art and architecture, including early sketchbooks, photographs, blueprints, and artists’ books.\n"},{"text":"Book Arts","to":"/collections/collecting-areas/special-collections/book-arts","description":"Artists’ books, fine press publications, and related archival materials.\n"},{"text":"Children's Literature","to":"/collections/collecting-areas/special-collections/childrens-literature","description":"Classic, pop-up and movable books, works by Midwestern authors and publishers, and archival material.\n"},{"text":"European History","to":"/collections/collecting-areas/special-collections/european-history","description":"Pamphlets, bibles, and early printed books covering early modern European politics, religion, and military advances.\n"},{"text":"History of Astronomy and Mathematics","to":"/collections/collecting-areas/special-collections/history-astronomy-and-mathematics","description":"Treaties, star atlases, manuscripts, and other materials documenting scientific developments in astronomy and related disciplines.\n","children":[{"text":"The Galileo Manuscript","to":"/collections/collecting-areas/special-collections/history-astronomy-and-mathematics/galileo","description":"Background and provenance of the forged manuscript and evidence that it is not authentic.\n"}]},{"text":"History of Medicine","to":"/collections/collecting-areas/special-collections/history-medicine","description":"Materials documenting the history of medicine from antiquity through the 20th century.\n"},{"text":"Islamic Manuscripts","to":"/collections/collecting-areas/special-collections/islamic-manuscripts","description":"Rich range of texts demonstrating manuscript production across historical periods and Islamicate cultural areas.\n"},{"text":"Janice Bluestein Longone Culinary Archive","to":"/collections/collecting-areas/special-collections/janice-bluestein-longone-culinary-archive","description":"Materials on the American culinary experience including cookbooks, ephemera, and restaurant menus.\n","children":[{"text":"About Janice Bluestein Longone","to":"/collections/collecting-areas/special-collections/janice-bluestein-longone-culinary-archive/about","description":"The Janice Bluestein Culinary Archive was shaped by the donation of its namesake, a culinary historian and adjunct curator.\n"}]},{"text":"Joseph A. Labadie Collection","to":"/collections/collecting-areas/special-collections/joseph-labadie-collection","description":"Books, pamphlets, ephemera, and more chronicling anarchism, political and social movements, and related topics.\n"},{"text":"Literature","to":"/collections/collecting-areas/special-collections/literature","description":"Published literary holdings spanning several centuries, in various languages. Also includes archival holdings, mostly poets of the 20th century.\n","children":[{"text":"American Literature","to":"/collections/collecting-areas/special-collections/literature/american-literature","description":"Published and archival materials, with particular strength in Postbeat poets.\n"},{"text":"British Isles Literature","to":"/collections/collecting-areas/special-collections/literature/british-isles-literature","description":"Principally published materials by authors from England, Ireland, and other parts of the British Isles.\n"},{"text":"Early Spanish Literature","to":"/collections/collecting-areas/special-collections/literature/early-spanish-literature","description":"Significant early editions of works by esteemed authors, comedias sueltas, and more from the Spanish Golden Age.\n"},{"text":"Hubbard Imaginary Voyages Collection","to":"/collections/collecting-areas/special-collections/literature/hubbard-imaginary-voyages-collection","description":"Editions of foundational 18th century imaginary voyages Robinson Crusoe and Gulliver’s Travels, as well as earlier and later imaginary voyages.\n"},{"text":"Russian Literature","to":"/collections/collecting-areas/special-collections/literature/russian-literature","description":"Records of small presses publishing Russian literature in the United States in the late 20th century and publications by and about author Vladimir Nabokov.\n"},{"text":"Science Fiction","to":"/collections/collecting-areas/special-collections/literature/science-fiction","description":"20th century periodicals and paperback novels.\n"},{"text":"The Shakespeare Collection","to":"/collections/collecting-areas/special-collections/literature/shakespeare-collection","description":"A comprehensive archive documenting the early editions of Shakespeare’s works.\n"}]},{"text":"Medieval and Renaissance Manuscripts","to":"/collections/collecting-areas/special-collections/medieval-and-renaissance-manuscripts","description":"Manuscript leaves, fragments, and codices from the 6th to the 16th centuries.\n"},{"text":"Music Library Special Collections","to":"/collections/collecting-areas/special-collections/music-library-special-collections","description":"Sheet music collections, plus scores, papers, recordings, and more.\n","children":[{"text":"Edison Sheet Music Collection","to":"/collections/collecting-areas/special-collections/music-library-special-collections/edison-sheet","description":"A comprehensive collection of published sheet music that was available in America before 1920.\n"},{"text":"Montgomery Sheet Music Collection","to":"/collections/collecting-areas/special-collections/music-library-special-collections/montgomery-sheet","description":"Materials documenting popular music in the early 20th century, including significant representation by Black composers.\n"},{"text":"Scores, Papers, and Recordings","to":"/collections/collecting-areas/special-collections/music-library-special-collections/scores-papers","description":"Varied music special collections from composers, musicians, arrangers, conductors, and more.\n"},{"text":"Women Composers Collection","to":"/collections/collecting-areas/special-collections/music-library-special-collections/women-composers","description":"Musical works and scores from more than 700 composers from the 18th through 20th centuries.\n"}]},{"text":"Papyrology Collection","to":"/collections/collecting-areas/special-collections/papyrology-collection","description":"A renowned collection of ancient texts dating from about 1,000 BCE to 1,000 CE.\n"},{"text":"Philippine History","to":"/collections/collecting-areas/special-collections/philippine-history","description":"Published works, manuscript items, and photographs documenting colonialist aspects of Philippine history in the early 1900s.\n"},{"text":"Screen Arts Mavericks and Makers","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers","description":"Papers and other materials from notable independent filmmakers and distributors documenting the film production process.\n","children":[{"text":"Alan Rudolph","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/alan-rudolph","description":"Production notes, script drafts and revisions, and on-set photos.\n"},{"text":"John Sayles","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/john-sayles","description":"Scripts, production documents, storyboards, personal writings, and more, including manuscripts of novels, short stories, and plays.\n"},{"text":"Jonathan Demme","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/jonathan-demme","description":"Vast assortment of scripts, costumes, research, audiovisual materials, and more, reflecting Demme’s varied career.\n"},{"text":"Lawrence Kasdan","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/lawrence-kasdan","description":"A range of documents generated at various stages of Kasdan's productions, plus audiovisual materials.\n"},{"text":"Nancy Savoca","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/nancy-savoca","description":"Materials representing nearly three decades of genuine indie filmmaking, including notes, photos, and script drafts, as well scripts for unproduced work.\n"},{"text":"Orson Welles","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/orson-welles","description":"Extensive archival materials covering all areas of Welles’s creative output, plus a substantial amount of personal material.\n"},{"text":"Robert Altman","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/robert-altman","description":"Massive array of scripts, photos, props, costumes, and more from Altman’s career directing television and film.\n"},{"text":"Ira Deutchman","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/ira-deutchman","description":"Festival catalogs, one-sheets, and distribution materials, plus correspondence providing a unique insider perspective on the filmmaking industry.\n"},{"text":"Robert Shaye","to":"/collections/collecting-areas/special-collections/screen-arts-mavericks-and-makers/robert-shaye","description":"Personal and business papers from the early years of New Line Cinema, plus articles, clippings, and select production materials.\n"}]},{"text":"Theatre History","to":"/collections/collecting-areas/special-collections/theatre-history","description":"Published and archival materials relevant to theatre history, particularly in the United States.\n"},{"text":"Transportation History","to":"/collections/collecting-areas/special-collections/transportation-history","description":"A unique body of work covering transportation modes and infrastructure.\n"},{"text":"William A. Gosling Pop-up and Movable Book Collection","to":"/collections/collecting-areas/special-collections/william-gosling-pop-and-movable-book-collection","description":"Pop-up and movable books, primarily commercially produced, dating back to the 19th century.\n"}]},{"text":"Specific Formats","to":"/collections/collecting-areas/specific-formats","description":"Video games, printed maps, newspapers, film, and more.\n","children":[{"text":"Comics and Graphic Novels","to":"/collections/collecting-areas/specific-formats/comics-and-graphic-novels","description":"Comics and graphic novels spanning various languages and types of narratives.\n"},{"text":"Computer and Video Games","to":"/collections/collecting-areas/specific-formats/computer-and-video-games","description":"Video games, gaming consoles, print, and other materials supporting the study of computer and video games.\n"},{"text":"Data","to":"/collections/collecting-areas/specific-formats/data","description":"Data to support research in a variety of disciplines.\n"},{"text":"Film and Video","to":"/collections/collecting-areas/specific-formats/film-and-video","description":"Feature films, documentaries, animated films, and educational programs in a variety of formats.\n"},{"text":"Government Information","to":"/collections/collecting-areas/specific-formats/government-information","description":"Materials produced by the U.S. federal government, the state of Michigan, and international governmental organizations.\n"},{"text":"Maps and Atlases","to":"/collections/collecting-areas/specific-formats/maps-and-atlases","description":"Extensive collection of maps, atlases, and related reference works from around the world.\n","children":[{"text":"Significant Map and Atlas Collections","to":"/collections/collecting-areas/specific-formats/maps-and-atlases/significant-map-and-atlas","description":"Our collection of maps and atlases include significant materials dating back to the 16th century.\n"}]},{"text":"News","to":"/collections/collecting-areas/specific-formats/news","description":"News and current event sources from around the world.\n"},{"text":"Web Archives","to":"/collections/collecting-areas/specific-formats/web-archives","description":"Collecting and preserving material from the web.\n"}]},{"text":"Undergraduate Collections","to":"/collections/collecting-areas/undergraduate-collections","description":"Introductory texts, as well as materials for coursework, lifelong learning, and leisure reading.\n"}]},{"text":"Collection Development Philosophy","to":"/collections/collection-development-philosophy","description":"Our approach to collection development activity and decision-making around acquisition and management of materials.\n"},{"text":"Digital Collections","to":"/collections/digital-collections","description":"Images, texts, and more from campus and regional libraries and museums, plus information about starting a digital collection.\n"},{"text":"Deep Blue Repositories","to":"/collections/deep-blue-repositories","description":"Access a wide array of documents and data produced by people at the University of Michigan.\n"},{"text":"Michigan Publishing Services and University of Michigan Press","to":"/collections/michigan-publishing-services-and-university-michigan-press","description":"Access or purchase scholarly and educational materials in a wide range of formats.\n"},{"text":"HathiTrust Digital Library","to":"/collections/hathitrust-digital-library","description":"Access millions of books and journals digitized from libraries around the world.\n"}]},{"text":"About Us","to":"/about-us","description":"Get to know who we are, the work we do, and how you can connect with us.\n","children":[{"text":"About the Library","to":"/about-us/about-library","description":"Learn about the values that guide our work.\n","children":[{"text":"Our Organization","to":"/about-us/about-library/our-organization","description":"Our expert, committed staff make an extraordinary array of resources and services available across campus and online.\n"},{"text":"Mission, Vision, and Values","to":"/about-us/about-library/mission-vision-and-values","description":"Learn about our mission and vision, along with the shared values that inform and guide our work.\n"},{"text":"Strategic Commitments and Actions","to":"/about-us/about-library/strategic-commitments-and-actions","description":"See our key focus areas for the next 3-5 years.\n"},{"text":"Accessibility","to":"/about-us/about-library/accessibility","description":"An overview of our commitment to accessibility and what we’re working on.\n","children":[{"text":"Accessibility Support ","to":"/about-us/about-library/accessibility/accessibility-support","description":"Access to accessible physical and digital materials, as well as support for using our spaces and attending events.\n"},{"text":"Accessibility Practices","to":"/about-us/about-library/accessibility/accessibility-practices","description":"Our approach to accessibility for instruction, digital products, and third-party resources, as well as Title II compliance.\n"},{"text":"Digital Product Accessibility","to":"/about-us/about-library/accessibility/digital-product-accessibility","description":"Our approach to digital accessibility and evaluations for products that we build or customize.\n"},{"text":"Library Website Accessibility","to":"/about-us/about-library/accessibility/library-website-accessibility","description":"How to contact us about the accessibility of the library website, along with a standards and evaluation summary.\n"}]},{"text":"Our Commitment to Diversity","to":"/about-us/about-library/our-commitment-diversity","description":"Learn how tenets of diversity and antiracism influence our work.\n","children":[{"text":"Library Advisory Council","to":"/about-us/about-library/our-commitment-diversity/library-advisory-council","description":"Library employees who provide leadership, support, and development opportunities in areas of diversity and inclusion.\n"}]},{"text":"Territorial Acknowledgement","to":"/about-us/about-library/territorial-acknowledgement","description":"Our acknowledgement in Anishinaabemowin and English, along with additional resources and readings.\n","children":[{"text":"Territorial Acknowledgement in Anishinaabemowin","to":"/about-us/about-library/territorial-acknowledgement/territorial-acknowledgement-anishinaabemowin","description":"The University of Michigan owes its creation and land to the Anishinaabe.\n"},{"text":"Territorial Acknowledgement in English","to":"/about-us/about-library/territorial-acknowledgement/territorial-acknowledgement-english","description":"The University of Michigan owes its creation and land to the Anishinaabe.\n"},{"text":"Resources and Further Reading","to":"/about-us/about-library/territorial-acknowledgement/resources-and-further-reading","description":"Learn more about the Indigenous peoples of Michigan and gain context surrounding land acknowledgements.\n"}]},{"text":"Library Repository Project","to":"/about-us/about-library/library-repository-project","description":"A repository building to store our physical collection and serve as a preservation and distribution hub.\n","children":[{"text":"Why a Repository","to":"/about-us/about-library/library-repository-project/why-repository","description":"A library repository to steward the physical collection and plan for the future.\n"},{"text":"Status and Timeline","to":"/about-us/about-library/library-repository-project/status-and-timeline","description":"The latest information on the library repository project.\n"}]},{"text":"Advocacy for Employees","to":"/about-us/about-library/advocacy-employees","description":"Our Librarians’ Forum and Staff Forum provide opportunity for library employees to amplify their influence.\n"},{"text":"Assessment","to":"/about-us/about-library/assessment","description":"We use a range of assessment methods to inform the services, spaces, and collections we offer.\n","children":[{"text":"Significant Assessment Projects","to":"/about-us/about-library/assessment/significant-assessment-projects","description":"Details and access to the findings of significant library-wide assessment projects.\n"},{"text":"Statistical Highlights","to":"/about-us/about-library/assessment/statistical-highlights","description":"Current data reflects the 2024-2025 fiscal year. The All campus libraries columns&nbsp;feature the&nbsp;data reported on the Association of Research Libraries Statistics Survey&nbsp;and represents&nbsp;combined data for University Library, Bentley Library, Clements Library, Law Library, and Kresge Library Services."}]},{"text":"Library Council","to":"/about-us/about-library/library-council","description":"Library Council, part of the Board of Regents bylaws, serves in an advisory capacity to the dean and has faculty and staff membership.\n"},{"text":"Library Blogs","to":"/about-us/about-library/library-blogs","description":"Read blog posts&nbsp;for a deeper look into our collections, services, and work.\n"}]},{"text":"Staff Directory","to":"/about-us/staff-directory","description":"Search by name, department, or division to find library staff who can connect you with resources and support.\n"},{"text":"Our Divisions and Departments","to":"/about-us/our-divisions-and-departments","description":"See our organizational structure and learn about work of our divisions and departments.\n","children":[{"text":"Library Administration","to":"/about-us/our-divisions-and-departments/library-administration","description":"The library’s leadership team, guided by our dean and associate dean.\n"},{"text":"Deans' Office","to":"/about-us/our-divisions-and-departments/deans-office","description":"Providing strategic direction and support as the administrative center of the library.\n","children":[{"text":"Administrative Support","to":"/about-us/our-divisions-and-departments/deans-office/administrative-support","description":"Providing essential administrative support for library divisions and maintaining efficient office operations.\n"},{"text":"Communication and Marketing","to":"/about-us/our-divisions-and-departments/deans-office/communication-and-marketing","description":"We tell stories from around the library, maintain brand and style guidelines, and support library staff in their outreach to faculty and students.\n"},{"text":"Development Office","to":"/about-us/our-divisions-and-departments/deans-office/development-office","description":"Learn about ways to make an impact on a cause you care about and support the library through philanthropic giving.\n"},{"text":"Finance","to":"/about-us/our-divisions-and-departments/deans-office/finance","description":"Establishing and carrying out the library's short and long-term budget and finance goals, strategies, plans, and policies.\n"},{"text":"Library Facilities","to":"/about-us/our-divisions-and-departments/deans-office/library-facilities","description":"Managing and looking after our buildings through monitoring, maintenance, and renovations.\n"},{"text":"Library Human Resources","to":"/about-us/our-divisions-and-departments/deans-office/library-human-resources","description":"We engage with the library community to recruit, develop, retain, advocate for, and support our colleagues.\n"},{"text":"Publishing Finance","to":"/about-us/our-divisions-and-departments/deans-office/publishing-finance","description":"We provide the support Michigan Publishing requires to sustain its business and operations.\n"},{"text":"Strategic Planning","to":"/about-us/our-divisions-and-departments/deans-office/strategic-planning","description":"Advocating for coordinated and intentional strategic planning efforts across the organization and supporting all library colleagues in this work.\n"}]},{"text":"Access and Fulfillment","to":"/about-us/our-divisions-and-departments/access-and-fulfillment","description":"Providing services to help you use library spaces and resources.\n","children":[{"text":"Circulation and Access Services and Divisional Libraries","to":"/about-us/our-divisions-and-departments/access-and-fulfillment/circulation-and-access-services-and","description":"Helping campus users find and use our onsite library resources, services, and collections.\n"},{"text":"Document Delivery","to":"/about-us/our-divisions-and-departments/access-and-fulfillment/document-delivery","description":"We provide interlibrary lending services, along with scanning and delivery of materials.\n"},{"text":"Physical Collections and Access","to":"/about-us/our-divisions-and-departments/access-and-fulfillment/physical-collections-and-access","description":"Ensuring access to the library’s physical collections, including materials in offsite shelving facilities.\n"}]},{"text":"Collections","to":"/about-us/our-divisions-and-departments/collections","description":"Providing and maintaining campus access to information resources in all formats and sources.\n","children":[{"text":"Asia Library","to":"/about-us/our-divisions-and-departments/collections/asia-library","description":"Collecting and providing access to resources in all formats in the Chinese, Japanese, and Korean languages.\n"},{"text":"International Studies","to":"/about-us/our-divisions-and-departments/collections/international-studies","description":"Supporting and engaging area studies scholarship.\n"},{"text":"Preservation Services","to":"/about-us/our-divisions-and-departments/collections/preservation-services","description":"Supporting the care and long-term retention of the library’s collections.\n"},{"text":"Special Collections","to":"/about-us/our-divisions-and-departments/collections/special-collections","description":"Providing access to collections of unique, rare, and primary source material.\n"}]},{"text":"Library Information Technology and Technical Services","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services","description":"Solving complex technology problems and developing solutions to add value to the library services and users at scale.\n","children":[{"text":"Architecture and Engineering","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/architecture-and-engineering","description":"Supporting library hardware and software infrastructure and integration and more.\n"},{"text":"Automation, Indexing, and Metadata","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/automation-indexing-and-metadata","description":"Developing, enhancing, and maintaining systems and processes that support our core operational functions.\n"},{"text":"Design and Discovery","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/design","description":"Specializing in project management, user experience research, design, web development, and digital accessibility.\n"},{"text":"Digital Content and Collections","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/digital-content-and-collections","description":"We digitize materials, prepare and ingest digital content into repositories, and create, host, and maintain digital collections.\n"},{"text":"Digital Library Applications","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/digital-library-applications","description":"We develop applications that enable digital preservation and access in order to provide long-term, sustainable solutions.\n"},{"text":"Technical Services","to":"/about-us/our-divisions-and-departments/library-information-technology-and-technical-services/technical-services","description":"Acquiring, describing, and supporting access to library resources.\n"}]},{"text":"Michigan Publishing","to":"/about-us/our-divisions-and-departments/michigan-publishing","description":"Supporting scholarship and helping increase its reach and visibility through innovative and accessible academic publishing, promotion, research data services, and more.\n","children":[{"text":"Copyright Office ","to":"/about-us/our-divisions-and-departments/michigan-publishing/copyright-office","description":"Providing information about copyright and related issues to support the university community.\n"},{"text":"Deep Blue Repository and Research Data Services","to":"/about-us/our-divisions-and-departments/michigan-publishing/deep-blue-repository-and-research-data","description":"Supporting open access to articles, data, and other content produced by U-M researchers.\n"},{"text":"Marketing and Outreach","to":"/about-us/our-divisions-and-departments/michigan-publishing/marketing-and-outreach","description":"We ensure that publications produced by Michigan Publishing are discovered, acquired, and enjoyed around the world.\n"},{"text":"Publishing Acquisitions","to":"/about-us/our-divisions-and-departments/michigan-publishing/publishing-acquisitions","description":"Through deep partnerships with University of Michigan Press authors, we create award-winning books and digital projects that have global impact.\n"},{"text":"Publishing Production","to":"/about-us/our-divisions-and-departments/michigan-publishing/publishing-production","description":"From an elegant print book to an innovative digital product, we apply decades of experience to ensure that University of Michigan Press products are recognized for their quality.\n"},{"text":"Publishing Services","to":"/about-us/our-divisions-and-departments/michigan-publishing/publishing-services","description":"As experts in scholarly publishing, we provide a suite of publishing-related services that help increase the visibility, reach, and impact of scholarship.\n"},{"text":"Publishing Technology","to":"/about-us/our-divisions-and-departments/michigan-publishing/publishing-technology","description":"Combining library and publishing expertise, our team develops open source technology solutions and maintains proprietary business systems.\n"}]},{"text":"Research and Learning","to":"/about-us/our-divisions-and-departments/research-and-learning","description":"Advancing discovery, research, learning, and teaching through collaborative services that support the creation and use of knowledge.\n","children":[{"text":"Accessibility","to":"/about-us/our-divisions-and-departments/research-and-learning/accessibility","description":"Improving accessibility and equitable access.\n"},{"text":"Arts and Humanities","to":"/about-us/our-divisions-and-departments/research-and-learning/arts-and-humanities","description":"Providing support for research and teaching in the humanities and the visual and performing arts.\n"},{"text":"Consultation and Discovery","to":"/about-us/our-divisions-and-departments/research-and-learning/consultation-and-discovery","description":"Providing consultation and reference services and support.\n"},{"text":"Digital Scholarship and Creative Spaces","to":"/about-us/our-divisions-and-departments/research-and-learning/digital-scholarship-and-creative","description":"A community of library experts and learning spaces facilitating creative exploration of tools and technology.\n"},{"text":"HS-STEM","to":"/about-us/our-divisions-and-departments/research-and-learning/hs-stem","description":"We provide high-quality information in health sciences, sciences, technology, engineering, and mathematics (HS-STEM).\n"},{"text":"Learning Programs and Initiatives","to":"/about-us/our-divisions-and-departments/research-and-learning/learning-programs-and-initiatives","description":"Providing instruction, digital learning, and student engagement programs to help students become skilled researchers.\n"},{"text":"Outreach and AV Services","to":"/about-us/our-divisions-and-departments/research-and-learning/outreach-and-av-services","description":"Helping connect campus to the library’s technology, event spaces, and onsite collaborations.\n"},{"text":"Social Sciences and Clark Library","to":"/about-us/our-divisions-and-departments/research-and-learning/social-sciences-and-clark-library","description":"Supporting research and teaching in the social sciences, and provide expertise in maps, government information and data services.\n"}]},{"text":"HathiTrust","to":"/about-us/our-divisions-and-departments/hathitrust","description":"A nonprofit collaborative of academic and research libraries preserving and providing access to millions of digitized items.\n"}]},{"text":"News","to":"/about-us/news","description":"Read news, stories, and announcements from around the library.\n"},{"text":"Work for Us","to":"/about-us/work-us","description":"Explore our open positions and learn about other opportunities that come up throughout the year.\n","children":[{"text":"Librarian and Staff Positions","to":"/about-us/work-us/librarian-and-staff-positions","description":"Find open jobs.\n","children":[{"text":"Cathleen A. Baker Fellowship in Conservation ","to":"/about-us/work-us/librarian-and-staff-positions/cathleen-baker-fellowship-conservation","description":"Build and share knowledge of working with paper-based collections in this specialized fellowship for conservation professionals.\n","children":[{"text":"Developing your Proposal","to":"/about-us/work-us/librarian-and-staff-positions/cathleen-baker-fellowship-conservation/developing","description":"What to include in your application for the library’s Cathleen A. Baker Fellowship in Conservation.\n"}]}]},{"text":"Jobs for Students","to":"/about-us/work-us/jobs-students","description":"Browse the paying positions open to students, including internships and fellowships.\n","children":[{"text":"Student Engagement Program","to":"/about-us/work-us/jobs-students/student-engagement-program","description":"Take the lead on projects or promotional and programmatic efforts at the library by becoming a paid student fellow or ambassador.\n","children":[{"text":"Engagement Fellows ","to":"/about-us/work-us/jobs-students/student-engagement-program/engagement-fellows","description":"Get career and leadership experience in this unique library fellowship.\n"},{"text":"Student Ambassadors","to":"/about-us/work-us/jobs-students/student-engagement-program/student-ambassadors","description":"Get event planning and social media marketing experience as a student ambassador for the library.\n"}]},{"text":"Michigan Library Scholars","to":"/about-us/work-us/jobs-students/michigan-library-scholars","description":"Get hands-on professional experience while working on a project with an international focus in this paid internship.\n","children":[{"text":"Summer 2026 Projects","to":"/about-us/work-us/jobs-students/michigan-library-scholars/summer-2026-projects","description":"Two projects for summer 2026 internships.\n"}]},{"text":"Design Lab Student Positions","to":"/about-us/work-us/jobs-students/design-lab-student-positions","description":"Join the hardworking team that keeps the lab running smoothly.\n"},{"text":"Summer Fellowship in Library User Experience","to":"/about-us/work-us/jobs-students/summer-fellowship-library-user-experience","description":"A paid opportunity for UMSI graduate students to gain experience in user research and design on digital library systems.\n"},{"text":"Lafer Preservation Internship Program","to":"/about-us/work-us/jobs-students/lafer-preservation-internship-program","description":"Contribute to a distinctive preservation project in this internship, open to students at various academic levels.\n"},{"text":"Archival Processing Internship Program","to":"/about-us/work-us/jobs-students/archival-processing-internship-program","description":"A 12-week internship for current and recent graduate students to work on an archival processing project.\n"}]}]},{"text":"Partner with Us","to":"/about-us/partner-us","description":"Find opportunities to engage with us, including installing an exhibit, digital showcases, promotional opportunities, and other unique collaboration ideas.\n","children":[{"text":"Student Consultants","to":"/about-us/partner-us/student-consultants","description":"Get help with library research, student-led events or exhibits, and more by working with a peer information consultant.\n"},{"text":"Install an Exhibit","to":"/about-us/partner-us/install-exhibit","description":"Collaborate with us to install an exhibit in the Hatcher Library.\n"},{"text":"Display a Digital Promotion or Showcase","to":"/about-us/partner-us/display-digital-promotion-or-showcase","description":"Use digital signs in the Shapiro Library to display a promotional slide or digital showcase.\n","children":[{"text":"Guidelines for Digital Signage Submissions","to":"/about-us/partner-us/display-digital-promotion-or-showcase/guidelines-digital-signage-submissions","description":"Instructions and guidelines for submitting content for your digital signage or showcase.\n"}]},{"text":"Host an Information Table or Donation Drive","to":"/about-us/partner-us/host-information-table-or-donation-drive","description":"University departments and student organizations can host an information table or donation drive in the Shapiro Library lobby.\n"},{"text":"Propose Your Unique Collaboration Idea","to":"/about-us/partner-us/propose-your-unique-collaboration-idea","description":"Want to collaborate with the library? Whatever your idea, we’re ready to listen.\n"},{"text":"Support for Campus Book Clubs ","to":"/about-us/partner-us/support-campus-book-clubs","description":"Resources for book clubs and reading groups, including our book club in a bag program.\n"}]},{"text":"Policies","to":"/about-us/policies","description":"Policies and guidelines that support our work.\n","children":[{"text":"Ask a Librarian Guidelines","to":"/about-us/policies/ask-librarian-guidelines","description":"The scope of our service, chat accessibility, and statements on privacy and acceptable behavior.\n"},{"text":"Building Access Policy ","to":"/about-us/policies/building-access-policy","description":"Policies and procedures supporting our commitment to maintaining a quality study and research environment, protecting the rights of users, and sustaining the integrity of collections.\n"},{"text":"Collections Access Policy","to":"/about-us/policies/collections-access-policy","description":"Ways to use materials from the library.\n"},{"text":"Commitment to Open Discovery","to":"/about-us/policies/commitment-open-discovery","description":"We support the NISO Open Discovery Initiative and commit to openness in discovery by sharing our conformance statement.\n"},{"text":"Copyright Policy","to":"/about-us/policies/copyright-policy","description":"Our practices around copyright generally, as well as license information for content on the library website.\n"},{"text":"Digital Preservation Policy","to":"/about-us/policies/digital-preservation-policy","description":"Decisions and commitments for content locally hosted in the digital repository services we manage.\n","children":[{"text":"Registered Formats and Support Levels","to":"/about-us/policies/digital-preservation-policy/registered-formats-and-support-levels","description":"The U-M Library is committed to providing long-term access to all deposited content by applying best practices for data management and digital preservation while also acknowledging the complexities involved in preserving digital information."},{"text":"Digital Preservation Baseline","to":"/about-us/policies/digital-preservation-policy/digital-preservation-baseline","description":"Establishes a shared definition of digital preservation and defines minimum activities required.\n"}]},{"text":"Disaster Response and Recovery Plan for Library Collections","to":"/about-us/policies/disaster-response-and-recovery-plan-library-collections","description":"Instructions for responding to a library collection disaster with specifics for the U-M Ann Arbor campus.\n"},{"text":"Digital Scholarship Framework and Policy","to":"/about-us/policies/digital-scholarship-framework-and-policy","description":"How we deliver digital scholarship support to faculty, staff and students, and what we can mutually expect from our working relationship.\n"},{"text":"Film and Photography in the Library","to":"/about-us/policies/film-and-photography-library","description":"Policies for taking photos or making videos or other recordings in library buildings.\n"},{"text":"Gifts of Books and Other Materials","to":"/about-us/policies/gifts-books-and-other-materials","description":"Our practices around accepting unsolicited gifts and other options for donating.\n"},{"text":"Library Privacy Statement","to":"/about-us/policies/library-privacy-statement","description":"We may collect information about your library use to improve services and to integrate with broader university teaching and learning initiatives.\n","children":[{"text":"Checkout History Options","to":"/about-us/policies/library-privacy-statement/checkout-history-options","description":"How to access your checkout history and set a preference for whether we keep it.\n"}]},{"text":"Protests and Demonstrations in the Library","to":"/about-us/policies/protests-and-demonstrations-library","description":"We take an intentional, inclusive stance and work to ensure safe and constructive spaces for protest as well as academic activities.\n"},{"text":"Remediation of Harmful Language in Descriptions of Collection Material","to":"/about-us/policies/remediation-harmful-language-descriptions-collection-material","description":"We stand against marginalization, oppression, and bias in its many forms. One way we look to combat this is by addressing exclusionary descriptive collection metadata.\n"},{"text":"Statement on Appropriate Use of Electronic Resources","to":"/about-us/policies/statement-appropriate-use-electronic-resources","description":"Our licensed electronic resources made available for research, instruction, and related activities of current University of Michigan faculty, staff, students and other authorized users.\n"},{"text":"Statement on Potentially Objectionable or Culturally Sensitive Collection Material","to":"/about-us/policies/statement-potentially-objectionable-or-culturally-sensitive-collection-material","description":"Our statement on works in the collection some might find uncomfortable and what guides material selection.\n"},{"text":"Takedown Policy for Addressing Copyright Concerns","to":"/about-us/policies/takedown-policy-addressing-copyright-concerns","description":"How to contact us with question or concerns about rights around the use of specific works.\n"},{"text":"Takedown Policy for Private Information in U-M Digital Collections","to":"/about-us/policies/takedown-policy-private-information-u-m-digital-collections","description":"How we approach private information in our digital collections.\n"}]}]}]</script><template id="mobile-icon-next" data-astro-cid-2pbn3ijq><svg width="24px" height="24px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path></svg></template><template id="mobile-icon-back" data-astro-cid-2pbn3ijq><svg width="24px" height="24px" viewBox="0 0 24 24" class aria-hidden="true" style="display: inline-block; fill: currentColor; vertical-align: middle; "><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg></template><template id="mobile-icon-forward" data-astro-cid-2pbn3ijq><svg width="24px" height="24px" viewBox="0 0 24 24" class ari