{
  "redirects": [
    {
      "source": "/records/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<h>[0-9A-Fa-f]{4})"
        }
      ],
      "destination": "/s/axn/:h/",
      "permanent": true
    },
    {
      "source": "/records",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<h>[0-9A-Fa-f]{4})"
        }
      ],
      "destination": "/s/axn/:h/",
      "permanent": true
    },
    {
      "source": "/records/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<n>[1-9][0-9]{0,5})"
        }
      ],
      "destination": "/s/records/:n/",
      "permanent": true
    },
    {
      "source": "/records",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<n>[1-9][0-9]{0,5})"
        }
      ],
      "destination": "/s/records/:n/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.alexanarch\\.com"
        }
      ],
      "destination": "https://www.alexanarch.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "alexanarch\\.com"
        }
      ],
      "destination": "https://www.alexanarch.org/$1",
      "permanent": true
    },
    {
      "source": "/observatory/surface-weather",
      "destination": "/observatory/",
      "permanent": true
    },
    {
      "source": "/observatory/surface-weather/",
      "destination": "/observatory/",
      "permanent": true
    },
    {
      "source": "/browse/",
      "destination": "/s/browse/",
      "permanent": true
    },
    {
      "source": "/wiki/",
      "destination": "/s/wiki/",
      "permanent": true
    },
    {
      "source": "/graph/",
      "destination": "/s/graph/",
      "permanent": true
    },
    {
      "source": "/axn/:hex([0-9A-Fa-f]{2,6})",
      "destination": "/s/axn/:hex",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://gc.zgo.at https://alexanarch.goatcounter.com https://raw.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://github.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/.well-known/resourcesync",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/data/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/api/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)\\.json",
      "destination": "/data/api/$1.json"
    },
    {
      "source": "/axn/constitution(.*)",
      "destination": "/axn/constitution$1"
    },
    {
      "source": "/axn/assets/(.*)",
      "destination": "/axn/assets/$1"
    },
    {
      "source": "/oai",
      "destination": "/api/oai"
    },
    {
      "source": "/oai/",
      "destination": "/api/oai"
    }
  ]
}